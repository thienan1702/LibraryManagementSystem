@using X.PagedList
@using X.PagedList.Mvc.Core

@model IPagedList<LibraryManagement.Models.AuditLog>
@{
    ViewData["Title"] = "Audit Logs";
}


<div class="page-card">

    <div class="d-flex justify-content-between align-items-center">

        <div>

            <div class="page-title">

                <i class="fas fa-clipboard-list text-primary me-2"></i>

                Audit Logs

            </div>

            <div class="page-subtitle">

                Track all important system activities

            </div>

          
        </div>

    </div>

</div>

<div class="row mb-3">

    <div class="col-md-3">

        <div class="small-box bg-primary">

            <div class="inner">

                <h3>@Model.TotalItemCount</h3>
                <p>Total Logs</p>

            </div>

            <div class="icon">

                <i class="fas fa-history"></i>

            </div>

        </div>

    </div>

</div>


<!-- SEARCH & FILTER -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-body">

        <form asp-action="Index"
              method="get"
              class="row g-3 align-items-end">

            <!-- SEARCH -->

            <div class="col-md-4">

                <label class="form-label fw-semibold">
                    Search
                </label>

                <div class="input-group">

                    <span class="input-group-text">
                        <i class="fas fa-search"></i>
                    </span>

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="User, entity, description..." />

                </div>

            </div>


            <!-- ACTION -->

            <div class="col-md-2">

                <label class="form-label fw-semibold">
                    Action
                </label>

                <select name="actionFilter"
                        class="form-select">

                    <option value="">
                        All Actions
                    </option>

                    <option value="Create"
                            selected="@(ViewBag.Action == "Create")">
                        Create
                    </option>

                    <option value="Update"
                            selected="@(ViewBag.Action == "Update")">
                        Update
                    </option>

                    <option value="Edit"
                            selected="@(ViewBag.Action == "Edit")">
                        Edit
                    </option>

                    <option value="Delete"
                            selected="@(ViewBag.Action == "Delete")">
                        Delete
                    </option>

                    <option value="Login"
                            selected="@(ViewBag.Action == "Login")">
                        Login
                    </option>

                    <option value="Logout"
                            selected="@(ViewBag.Action == "Logout")">
                        Logout
                    </option>

                </select>

            </div>


            <!-- FROM -->

            <div class="col-md-2">

                <label class="form-label fw-semibold">
                    From
                </label>

                <input type="date"
                       name="fromDate"
                       value="@ViewBag.FromDate"
                       class="form-control" />

            </div>


            <!-- TO -->

            <div class="col-md-2">

                <label class="form-label fw-semibold">
                    To
                </label>

                <input type="date"
                       name="toDate"
                       value="@ViewBag.ToDate"
                       class="form-control" />

            </div>


            <!-- BUTTON -->

            <div class="col-md-2">

                <button type="submit"
                        class="btn btn-primary w-100">

                    <i class="fas fa-filter me-1"></i>

                    Filter

                </button>

            </div>

        </form>


        @if (!string.IsNullOrWhiteSpace(ViewBag.Search)
                || !string.IsNullOrWhiteSpace(ViewBag.Action)
                || !string.IsNullOrWhiteSpace(ViewBag.FromDate)
                || !string.IsNullOrWhiteSpace(ViewBag.ToDate))
        {
            <div class="mt-3">

                <a asp-action="Index"
                   class="btn btn-outline-secondary btn-sm">

                    <i class="fas fa-xmark me-1"></i>

                    Clear Filters

                </a>

            </div>
        }

    </div>

</div>



<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-dark">

                    <tr>

                        <th width="70">
                            #
                        </th>

                        <th width="180">

                            <i class="fas fa-clock"></i>

                            Time

                        </th>

                        <th width="220">

                            <i class="fas fa-user"></i>

                            User

                        </th>

                        <th width="150">

                            Action

                        </th>

                        <th width="180">

                            Entity

                        </th>

                        <th>

                            Description

                        </th>

                    </tr>

                </thead>

                <tbody>

                    
                    @{
                        int stt = (Model.PageNumber - 1) * Model.PageSize + 1;
                    }

                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- STT -->
                            <td>

                                <span class="badge bg-primary">

                                    @stt

                                </span>

                            </td>


                            <!-- Time -->
                            <td>

                                @item.Time.ToString("dd/MM/yyyy")

                                <br />

                                <small class="text-muted">

                                    @item.Time.ToString("HH:mm:ss")

                                </small>

                            </td>


                            <!-- User -->
                            <td>

                                <div class="d-flex align-items-center">

                                    <div class="avatar-circle">

                                        @(string.IsNullOrEmpty(item.UserName)
                                                                            ? "?"
                                                                            : item.UserName.Substring(0, 1).ToUpper())

                                </div>

                                    <div class="ms-2">

                                        <strong>

                                            @item.UserName

                                        </strong>

                                    </div>

                                </div>

                            </td>


                            <!-- Action -->
                            <td>

                            @switch (item.Action)
                                {
                                    case "Create":

                                        <span class="badge bg-success">

                                            <i class="fas fa-plus"></i>

                                            Create

                                        </span>

                                        break;


                                    case "Update":

                                    case "Edit":

                                        <span class="badge bg-warning text-dark">

                                            <i class="fas fa-pen"></i>

                                            Update

                                        </span>

                                        break;


                                    case "Delete":

                                        <span class="badge bg-danger">

                                            <i class="fas fa-trash"></i>

                                            Delete

                                        </span>

                                        break;


                                    case "Login":

                                        <span class="badge bg-info">

                                            <i class="fas fa-right-to-bracket"></i>

                                            Login

                                        </span>

                                        break;


                                    case "Logout":

                                        <span class="badge bg-secondary">

                                            <i class="fas fa-right-from-bracket"></i>

                                            Logout

                                        </span>

                                        break;


                                    default:

                                        <span class="badge bg-primary">

                                            @item.Action

                                        </span>

                                        break;
                                }

                            </td>


                            <!-- Entity -->
                            <td>

                                <span class="badge bg-light text-dark border">

                                    @item.Entity

                                </span>

                            </td>


                            <!-- Description -->
                            <td>

                                <div class="bg-light rounded p-2">

                                    @item.Description

                                </div>

                            </td>

                        </tr>

                        stt++;
                    }


                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="6" class="text-center py-5">

                                <i class="fas fa-folder-open fa-3x text-muted mb-3"></i>

                                <h5>

                                    No audit logs found

                                </h5>

                                <span class="text-muted">

                                    System activities will appear here.

                                </span>

                            </td>

                        </tr>
                    }
                    

                </tbody>

            </table>

        </div>

    </div>

</div>
<div class="d-flex justify-content-center mt-4">

    @Html.PagedListPager(

    Model,

    page => Url.Action("Index", new
    {
        page,
        search = ViewBag.Search,
        action = ViewBag.Action,
        fromDate = ViewBag.FromDate,
        toDate = ViewBag.ToDate
    }),

        new PagedListRenderOptions
        {
            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
            DisplayLinkToLastPage = PagedListDisplayMode.Always,
            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
            DisplayLinkToNextPage = PagedListDisplayMode.Always,

            LinkToFirstPageFormat = "<<",
            LinkToPreviousPageFormat = "Previous",
            LinkToNextPageFormat = "Next",
            LinkToLastPageFormat = ">>",

            MaximumPageNumbersToDisplay = 5,

            UlElementClasses = new[] { "pagination" },

            LiElementClasses = new[] { "page-item" },

            PageClasses = new[] { "page-link" }
        })

</div>

 <style>

    .audit-filter-card {
        border-radius: 14px;
    }

    .audit-filter-card .form-control,
    .audit-filter-card .form-select {
        height: 42px;
        border-radius: 8px;
    }

    .audit-filter-card .btn {
        height: 42px;
        border-radius: 8px;
        font-weight: 600;
    }

    .audit-filter-card label {
        font-size: 13px;
        color: #495057;
    }

</style>