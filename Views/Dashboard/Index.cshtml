@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">Library Dashboard</h2>

<div class="row">

    <div class="col-md-3 mb-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <h2>@ViewBag.TotalBooks</h2>
                <p>Total Books</p>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h2>@ViewBag.TotalAuthors</h2>
                <p>Total Authors</p>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card bg-warning">
            <div class="card-body">
                <h2>@ViewBag.TotalCategories</h2>
                <p>Total Categories</p>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card bg-danger text-white">
            <div class="card-body">
                <h2>@ViewBag.TotalPublishers</h2>
                <p>Total Publishers</p>
            </div>
        </div>
    </div>

</div>

<div class="row mb-4">

    <div class="col-md-3">
        <div class="card border-primary">
            <div class="card-body text-center">
                <h3>@ViewBag.TotalBorrow</h3>
                <p>Total Borrow</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-warning">
            <div class="card-body text-center">
                <h3>@ViewBag.Borrowing</h3>
                <p>Borrowing</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-success">
            <div class="card-body text-center">
                <h3>@ViewBag.Returned</h3>
                <p>Returned</p>
            </div>
        </div>
    </div>

</div>

<div class="row">

    <div class="col-md-6">

        <div class="card">

            <div class="card-header bg-dark text-white">
                Borrow Status
            </div>

            <div class="card-body">
                <canvas id="borrowChart"></canvas>
            </div>

        </div>

    </div>

    <div class="col-md-6">

        <div class="card">

            <div class="card-header bg-dark text-white">
                Top 5 Borrowed Books
            </div>

            <div class="card-body">

                <table class="table table-striped table-bordered">

                    <thead>

                        <tr>
                            <th>Book</th>
                            <th>Total Borrowed</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (dynamic item in ViewBag.TopBooks)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Total</td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <div class="row mt-4">

        <div class="col-md-6">

            <div class="card">

                <div class="card-header bg-primary text-white">
                    New Books
                </div>

                <div class="card-body">

                    <table class="table table-sm">

                        @foreach (var b in ViewBag.NewBooks)
                        {
                            <tr>

                                <td>@b.Title</td>

                                <td>@b.Quantity</td>

                            </tr>
                        }

                    </table>

                </div>

            </div>

        </div>

        <div class="col-md-6">

            <div class="card">

                <div class="card-header bg-danger text-white">
                    Low Stock
                </div>

                <div class="card-body">

                    <table class="table table-sm">

                        @foreach (var b in ViewBag.LowStockBooks)
                        {
                            <tr>

                                <td>@b.Title</td>

                                <td>

                                    <span class="badge bg-danger">

                                        @b.AvailableQuantity

                                    </span>

                                </td>

                            </tr>
                        }

                    </table>

                </div>

            </div>

        </div>

    </div>

    <div class="row mt-4">

        <div class="col-md-12">

            <div class="card">

                <div class="card-header bg-primary text-white">

                    Borrow Statistics By Month

                </div>

                <div class="card-body">

                    <canvas id="monthlyChart"></canvas>

                </div>

            </div>

        </div>

    </div>

    <div class="row mt-4">

        <div class="col-md-12">

            <div class="card">

                <div class="card-header bg-success text-white">

                    Borrow Trend

                </div>

                <div class="card-body">

                    <canvas id="lineChart"></canvas>

                </div>

            </div>

        </div>

    </div>

    <div class="card mt-4">

        <div class="card-header bg-dark text-white">

            Overdue Books

        </div>

        <div class="card-body">

            <table class="table">

                <thead>

                    <tr>

                        <th>Borrower</th>

                        <th>Due Date</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var b in ViewBag.Overdue)
                    {
                        <tr>

                            <td>@b.BorrowerName</td>

                            <td>

                                @b.ReturnDate?.ToString("dd/MM/yyyy")

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const ctx = document.getElementById('borrowChart');

        new Chart(ctx, {

            type: 'pie',

            data: {

                labels: ['Borrowing', 'Returned'],

                datasets: [{
                    data: [
                        @ViewBag.Borrowing,
                        @ViewBag.Returned
                    ]
                }]

            }

        });

    </script>
}

<script>

    const monthCtx =
    document.getElementById('monthlyChart');

    new Chart(monthCtx,{

    type:'bar',

    data:{

    labels:[
    'Jan','Feb','Mar','Apr','May','Jun',
    'Jul','Aug','Sep','Oct','Nov','Dec'
    ],

    datasets:[{

    label:'Borrow',

    data:@Html.Raw(ViewBag.MonthlyBorrow)

    }]

    }

    });

</script>
<script>

    const lineCtx=
    document.getElementById('lineChart');

    new Chart(lineCtx,{

    type:'line',

    data:{

    labels:[
    'Jan','Feb','Mar','Apr','May','Jun',
    'Jul','Aug','Sep','Oct','Nov','Dec'
    ],

    datasets:[{

    label:'Borrow',

    fill:false,

    tension:.3,

    data:@Html.Raw(ViewBag.MonthlyBorrow)

    }]

    }

    });

</script>