@{
    ViewData["Title"] = "Dashboard";
}
<div class="card bg-gradient-primary text-white shadow mb-4">

    <div class="card-body">

        <h3>

            Welcome,

            @User.Identity?.Name

        </h3>

        <p class="mb-0">

            @DateTime.Now.ToString("dddd, dd MMMM yyyy")

        </p>

    </div>

</div>
<div class="content-header">

    <div class="container-fluid">

        <div class="row mb-3">

            <div class="col-sm-6">

                <h2 class="fw-bold">

                    <i class="fas fa-chart-line text-primary"></i>

                    Library Dashboard

                </h2>

                <small class="text-muted">

                    Overview of your library system

                </small>

            </div>

            <div class="col-sm-6 text-end">

                <a asp-controller="Borrows"
                   asp-action="Create"
                   class="btn btn-primary">

                    <i class="fas fa-book-reader"></i>

                    Borrow

                </a>

                <a asp-controller="Reservations"
                   asp-action="Create"
                   class="btn btn-success">

                    <i class="fas fa-bookmark"></i>

                    Reservation

                </a>

                <a asp-controller="Books"
                   asp-action="Create"
                   class="btn btn-warning">

                    <i class="fas fa-plus"></i>

                    New Book

                </a>

            </div>

        </div>

    </div>

</div>


<div class="row">

    <div class="col-lg-3 col-6">

        <div class="small-box bg-primary">

            <div class="inner">

                <h3>@ViewBag.TotalBooks</h3>

                <p>Total Books</p>

            </div>

            <div class="icon">

                <i class="fas fa-book"></i>

            </div>

        </div>

    </div>

    <div class="col-lg-3 col-6">

        <div class="small-box bg-success">

            <div class="inner">

                <h3>@ViewBag.TotalBorrow</h3>

                <p>Total Borrow</p>

            </div>

            <div class="icon">

                <i class="fas fa-book-reader"></i>

            </div>

        </div>

    </div>

    <div class="col-lg-3 col-6">

        <div class="small-box bg-warning">

            <div class="inner">

                <h3>@ViewBag.Borrowing</h3>

                <p>Borrowing</p>

            </div>

            <div class="icon">

                <i class="fas fa-clock"></i>

            </div>

        </div>

    </div>

    <div class="col-lg-3 col-6">

        <div class="small-box bg-danger">

            <div class="inner">

                <h3>@ViewBag.Overdue.Count</h3>

                <p>Overdue</p>

            </div>

            <div class="icon">

                <i class="fas fa-exclamation-triangle"></i>

            </div>

        </div>

    </div>

</div>

<div class="row">

    <div class="col-lg-3 col-md-6">

        <div class="info-box">

            <span class="info-box-icon bg-info">

                <i class="fas fa-user"></i>

            </span>

            <div class="info-box-content">

                <span class="info-box-text">

                    Authors

                </span>

                <span class="info-box-number">

                    @ViewBag.TotalAuthors

                </span>

            </div>

        </div>

    </div>

    <div class="col-lg-3 col-md-6">

        <div class="info-box">

            <span class="info-box-icon bg-success">

                <i class="fas fa-tags"></i>

            </span>

            <div class="info-box-content">

                <span class="info-box-text">

                    Categories

                </span>

                <span class="info-box-number">

                    @ViewBag.TotalCategories

                </span>

            </div>

        </div>

    </div>

    <div class="col-lg-3 col-md-6">

        <div class="info-box">

            <span class="info-box-icon bg-warning">

                <i class="fas fa-building"></i>

            </span>

            <div class="info-box-content">

                <span class="info-box-text">

                    Publishers

                </span>

                <span class="info-box-number">

                    @ViewBag.TotalPublishers

                </span>

            </div>

        </div>

    </div>

    <div class="col-lg-3 col-md-6">

        <div class="info-box">

            <span class="info-box-icon bg-danger">

                <i class="fas fa-check-circle"></i>

            </span>

            <div class="info-box-content">

                <span class="info-box-text">

                    Returned

                </span>

                <span class="info-box-number">

                    @ViewBag.Returned

                </span>

            </div>

        </div>

    </div>

</div>

<div class="row">

    <!-- Borrow Status -->

    <div class="col-lg-4">

        <div class="card card-primary card-outline">

            <div class="card-header">

                <h3 class="card-title">

                    <i class="fas fa-chart-pie"></i>

                    Borrow Status

                </h3>

            </div>

            <div class="card-body">

                <canvas id="borrowChart"
                        height="250"></canvas>

            </div>

        </div>

    </div>

    <!-- Top Borrowed Books -->

    <div class="col-lg-4">

        <div class="card card-success card-outline">

            <div class="card-header">

                <h3 class="card-title">

                    <i class="fas fa-fire"></i>

                    Top Borrowed Books

                </h3>

            </div>


            <div class="row mt-4">

                <div class="col-md-6">

                    <div class="card">

                        <div class="card-header bg-info text-white">

                            Books By Category

                        </div>

                        <div class="card-body">

                            <canvas id="categoryChart"></canvas>

                        </div>

                    </div>

                </div>

            </div>

            <div class="card-body">

                @{

                    int max = 1;

                    if (((IEnumerable<dynamic>)ViewBag.TopBooks).Any())
                    {
                        max = ((IEnumerable<dynamic>)ViewBag.TopBooks)
                        .Max(x => (int)x.Total);
                    }

                }

                @foreach (dynamic item in ViewBag.TopBooks)
                {
                    var percent =
                    (int)((double)item.Total / max * 100);

                    <div class="mb-3">

                        <div class="d-flex justify-content-between">

                            <span>

                                @item.Name

                            </span>

                            <b>

                                @item.Total

                            </b>

                        </div>

                        <div class="progress">

                            <div class="progress-bar bg-success"
                                 style="width:@percent%">
                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>

    <!-- Quick Statistics -->

    <div class="col-lg-4">

        <div class="card card-warning card-outline">

            <div class="card-header">

                <h3 class="card-title">

                    <i class="fas fa-bolt"></i>

                    Quick Statistics

                </h3>

            </div>

            <div class="card-body">

                <div class="d-flex justify-content-between mb-3">

                    <span>

                        Available Books

                    </span>

                    <b>

                        @ViewBag.TotalBooks

                    </b>

                </div>

                <div class="d-flex justify-content-between mb-3">

                    <span>

                        Borrowing

                    </span>

                    <b class="text-warning">

                        @ViewBag.Borrowing

                    </b>

                </div>

                <div class="d-flex justify-content-between mb-3">

                    <span>

                        Returned

                    </span>

                    <b class="text-success">

                        @ViewBag.Returned

                    </b>

                </div>

                <div class="d-flex justify-content-between">

                    <span>

                        Overdue

                    </span>

                    <b class="text-danger">

                        @ViewBag.Overdue.Count

                    </b>

                </div>

            </div>

        </div>

    </div>

</div>

<hr />

<div class="row">

    <!-- New Books -->

    <div class="col-lg-6">

        <div class="card card-info">

            <div class="card-header">

                <h3 class="card-title">

                    <i class="fas fa-book-medical"></i>

                    Recently Added Books

                </h3>

            </div>

            <div class="card-body table-responsive p-0">

                <table class="table table-hover">

                    <thead>

                        <tr>

                            <th>Book</th>

                            <th width="100">

                                Qty

                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var b in ViewBag.NewBooks)
                        {
                            <tr>

                                <td>

                                    @b.Title

                                </td>

                                <td>

                                    <span class="badge bg-primary">

                                        @b.Quantity

                                    </span>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <!-- Low Stock -->

    <div class="col-lg-6">

        <div class="card card-danger">

            <div class="card-header">

                <h3 class="card-title">

                    <i class="fas fa-exclamation-circle"></i>

                    Low Stock Books

                </h3>

            </div>

            <div class="card-body table-responsive p-0">

                <table class="table table-hover">

                    <thead>

                        <tr>

                            <th>Book</th>

                            <th width="120">

                                Available

                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var b in ViewBag.LowStockBooks)
                        {

                            var color = "bg-success";

                            if (b.AvailableQuantity <= 1)
                            {
                                color = "bg-danger";
                            }
                            else if (b.AvailableQuantity <= 3)
                            {
                                color = "bg-warning";
                            }

                            <tr>

                                <td>

                                    @b.Title

                                </td>

                                <td>

                                    <span class="badge @color">

                                        @b.AvailableQuantity

                                    </span>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<div class="row mt-4">

    <div class="col-lg-6">

        <div class="card shadow-sm">

            <div class="card-header bg-info text-white">

                <i class="fas fa-history"></i>

                Recent Activities

            </div>

            <div class="card-body">

                <ul class="timeline">

                    @foreach (var item in ViewBag.RecentActivities)
                    {
                        <li class="mb-3">

                            @if (item.IsReturned)
                            {
                                <i class="fas fa-undo text-success"></i>
                            }
                            else
                            {
                                <i class="fas fa-book text-primary"></i>
                            }

                            <strong>

                                @item.BorrowerName

                            </strong>

                            <br />

                            <small class="text-muted">

                                @item.BorrowDate.ToString("dd/MM/yyyy HH:mm")

                            </small>

                        </li>
                    }

                </ul>

            </div>

        </div>

    </div>
</div>



<div class="col-lg-6">

    <div class="card shadow-sm">

        <div class="card-header bg-success text-white">

            Top Borrowers

        </div>

        <div class="card-body">

            <table class="table">

                <thead>

                    <tr>

                        <th>Name</th>

                        <th>Total</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in ViewBag.TopBorrowers)
                    {
                        <tr>

                            <td>@item.Name</td>

                            <td>

                                <span class="badge bg-primary">

                                    @item.Total

                                </span>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>



<div class="row mt-4">

    <!-- Monthly Borrow -->

    <div class="col-lg-8">

        <div class="card card-primary card-outline">

            <div class="card-header">

                <h3 class="card-title">

                    <i class="fas fa-chart-bar"></i>

                    Borrow Statistics By Month

                </h3>

            </div>

            <div class="card-body">

                <canvas id="monthlyChart" height="120"></canvas>

            </div>

        </div>

    </div>

    <!-- Borrow Trend -->

    <div class="col-lg-4">

        <div class="card card-success card-outline">

            <div class="card-header">

                <h3 class="card-title">

                    <i class="fas fa-chart-line"></i>

                    Borrow Trend

                </h3>

            </div>

            <div class="card-body">

                <canvas id="lineChart" height="220"></canvas>

            </div>

        </div>

    </div>

</div>

<div class="row mt-4">

    <!-- Overdue Table -->

    <div class="col-lg-8">

        <div class="card card-danger">

            <div class="card-header">

                <h3 class="card-title">

                    <i class="fas fa-exclamation-triangle"></i>

                    Overdue Books

                </h3>

            </div>

            <div class="card-body table-responsive p-0">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>Borrower</th>

                            <th>Due Date</th>

                            <th width="100">Days</th>

                            <th width="120">Fine</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var b in ViewBag.Overdue)
                        {
                            var days = (DateTime.Today - b.DueDate.Date).Days;

                            <tr>

                                <td>

                                    <strong>@b.BorrowerName</strong>

                                </td>

                                <td>

                                    @b.DueDate.ToString("dd/MM/yyyy")

                                </td>

                                <td>

                                    <span class="badge bg-danger">

                                        @days day(s)

                                    </span>

                                </td>

                                <td>

                                    <span class="text-danger fw-bold">

                                        @String.Format("{0:N0} đ", b.FineAmount)

                                    </span>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <!-- Recent Activity -->

    <div class="col-lg-4">

        <div class="card card-info">

            <div class="card-header">

                <h3 class="card-title">

                    <i class="fas fa-history"></i>

                    Recent Borrow

                </h3>

            </div>

            <div class="card-body">

                @foreach (var b in ViewBag.RecentBorrow)
                {
                    <div class="d-flex align-items-start mb-3">

                        <div class="me-3">

                            <span class="badge bg-primary p-2">

                                <i class="fas fa-book"></i>

                            </span>

                        </div>

                        <div class="flex-grow-1">

                            <div class="fw-semibold">

                                @b.BorrowerName

                            </div>

                            <small class="text-muted">

                                @b.BorrowDate.ToString("dd/MM/yyyy")

                            </small>

                        </div>

                    </div>

                    <hr />
                }

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const monthLabels = [
            'Jan','Feb','Mar','Apr','May','Jun',
            'Jul','Aug','Sep','Oct','Nov','Dec'
        ];

        const monthlyData = @Html.Raw(ViewBag.MonthlyBorrow);

        //================ Borrow Status =================

        new Chart(document.getElementById('borrowChart'),{

            type:'doughnut',

            data:{
                labels:['Borrowing','Returned','Overdue'],
                datasets:[{
                    data:[
                        @ViewBag.Borrowing,
                        @ViewBag.Returned,
                        @ViewBag.Overdue.Count
                    ],
                    backgroundColor:[
                        '#f59e0b',
                        '#10b981',
                        '#ef4444'
                    ],
                    borderWidth:0
                }]
            },

            options:{
                responsive:true,
                cutout:'65%',
                plugins:{
                    legend:{
                        position:'bottom'
                    }
                }
            }

        });

        //================ Monthly Borrow =================

        new Chart(document.getElementById('monthlyChart'),{

            type:'bar',

            data:{
                labels:monthLabels,
                datasets:[{
                    label:'Borrow',
                    data:monthlyData,
                    backgroundColor:'#2563eb',
                    borderRadius:8,
                    maxBarThickness:38
                }]
            },

            options:{
                responsive:true,
                plugins:{
                    legend:{
                        display:false
                    }
                },
                scales:{
                    y:{
                        beginAtZero:true,
                        grid:{
                            color:'#eef2f7'
                        }
                    },
                    x:{
                        grid:{
                            display:false
                        }
                    }
                }
            }

        });

        //================ Borrow Trend =================

        new Chart(document.getElementById('lineChart'),{

            type:'line',

            data:{
                labels:monthLabels,
                datasets:[{
                    label:'Borrow',
                    data:monthlyData,
                    borderColor:'#10b981',
                    backgroundColor:'rgba(16,185,129,.15)',
                    fill:true,
                    tension:.35,
                    pointRadius:4,
                    pointBackgroundColor:'#10b981'
                }]
            },

            options:{
                responsive:true,
                plugins:{
                    legend:{
                        display:false
                    }
                },
                scales:{
                    y:{
                        beginAtZero:true,
                        grid:{
                            color:'#eef2f7'
                        }
                    },
                    x:{
                        grid:{
                            display:false
                        }
                    }
                }
            }

        });

                const categoryCtx =
        document.getElementById("categoryChart");

        new Chart(categoryCtx,{

            type:"doughnut",

            data:{

                labels:@Html.Raw(ViewBag.CategoryLabel),

                datasets:[{

                    data:@Html.Raw(ViewBag.CategoryValue)

                }]

            }

        });

    </script>

}