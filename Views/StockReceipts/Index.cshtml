@using X.PagedList
@using X.PagedList.Mvc.Core

@model IPagedList<LibraryManagement.Models.StockReceipt>
@{
    ViewData["Title"] = "Stock In";
}

<div class="page-card">

    <div class="d-flex justify-content-between align-items-center">

        <div>
            <div class="page-title">

                <i class="fas fa-boxes-stacked text-primary me-2"></i>

                Stock In

            </div>

            <div class="page-subtitle">

                Manage stock-in receipts and imported books

            </div>
        </div>


        <div class="d-flex gap-2">

            <a asp-action="Create"
               class="btn btn-primary">

                <i class="fas fa-plus me-1"></i>

                New Stock Receipt

            </a>

        </div>

    </div>

</div>


<!-- STATISTICS -->

<div class="row mb-4">

    <div class="col-md-4">

        <div class="card shadow-sm border-0 text-center">

            <div class="card-body">

                <i class="fas fa-file-invoice fa-2x text-primary mb-2"></i>

                <h6>Total Receipts</h6>

                <h3>
                    @ViewBag.TotalReceipts
                </h3>

            </div>

        </div>

    </div>


    <div class="col-md-4">

        <div class="card shadow-sm border-0 text-center">

            <div class="card-body">

                <i class="fas fa-boxes-stacked fa-2x text-success mb-2"></i>

                <h6>Total Books Imported</h6>

                <h3>
                    @ViewBag.TotalBooks
                </h3>

            </div>

        </div>

    </div>


    <div class="col-md-4">

        <div class="card shadow-sm border-0 text-center">

            <div class="card-body">

                <i class="fas fa-money-bill-wave fa-2x text-danger mb-2"></i>

                <h6>Total Import Value</h6>
                <h3 class="text-danger fw-bold">
                    @Convert.ToDecimal(ViewBag.TotalImportValue).ToString("N0") VNĐ
                </h3>

            </div>

        </div>

    </div>

</div>


<!-- SEARCH -->

<div class="page-card mb-4">

    <form asp-action="Index"
          method="get">

        <div class="row g-2">

            <div class="col-md-6">

                <div class="search-box">

                    <i class="fas fa-search"></i>

                    <input name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Search receipt code, supplier..." />

                </div>

            </div>


            <div class="col-md-6">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="fas fa-search me-1"></i>

                    Search

                </button>


                <a asp-action="Index"
                   class="btn btn-secondary">

                    <i class="fas fa-rotate-left me-1"></i>

                    Reset

                </a>

            </div>

        </div>

    </form>

</div>


<!-- TABLE -->

<div class="page-card">

    <div class="table-responsive">

        <table class="table table-hover table-bordered align-middle">

            <thead class="table-dark">

                <tr>

                    <th width="60">
                        #
                    </th>

                    <th>
                        Receipt Code
                    </th>

                    <th>
                        Receipt Date
                    </th>

                    <th>
                        Supplier
                    </th>

                    <th>
                        Created By
                    </th>

                    <th class="text-center">
                        Items
                    </th>

                    <th class="text-end">
                        Total Amount
                    </th>

                    <th width="120">
                        Action
                    </th>

                </tr>

            </thead>


            <tbody>

                @{
                    int stt = (Model.PageNumber - 1)
                    * Model.PageSize + 1;
                }

                @foreach (var item in Model)
                {
                    <tr>

                        <!-- STT -->

                        <td>

                            @stt

                        </td>


                        <!-- RECEIPT CODE -->

                        <td>

                            <strong>

                                @item.ReceiptCode

                            </strong>

                        </td>


                        <!-- DATE -->
                        <td>
                            @item.ReceiptDate.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <!-- SUPPLIER -->

                        <td>

                            @if (item.Supplier != null)
                            {
                                <strong>

                                    @item.Supplier.Name

                                </strong>

                                @if (!string.IsNullOrWhiteSpace(item.Supplier.Phone))
                                {
                                    <br />

                                    <small class="text-muted">

                                        <i class="fas fa-phone me-1"></i>

                                        @item.Supplier.Phone

                                    </small>
                                }
                            }
                            else
                            {
                                <span class="text-muted">

                                    -

                                </span>
                            }

                        </td>


                        <!-- CREATED BY -->

                        <td>

                            @item.CreatedBy

                        </td>


                        <!-- ITEMS -->

                        <td class="text-center">

                            <span class="badge bg-primary fs-6">

                                @item.Details.Count

                            </span>

                        </td>


                        <!-- TOTAL -->

                        <td class="text-end">

                            <strong class="text-danger">

                                @item.TotalAmount.ToString("N0") VNĐ

                            </strong>

                        </td>


                        <!-- ACTION -->

                        <td>
                            <div class="d-flex justify-content-center gap-1">

                                <!-- Details -->
                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-primary"
                                   title="View Details">

                                    <i class="fas fa-eye"></i>

                                </a>


                                <!-- Export Invoice -->
                                <a asp-action="ExportInvoice"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-success"
                                   title="Export Invoice">

                                    <i class="fas fa-file-pdf"></i>

                                </a>


                                <!-- Edit -->
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-warning"
                                   title="Edit">

                                    <i class="fas fa-pen"></i>

                                </a>


                                <!-- Delete -->
                                <form asp-action="DeleteConfirmed"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-danger"
                                            title="Delete"
                                            onclick="return confirm('Are you sure you want to delete this stock receipt?');">

                                        <i class="fas fa-trash"></i>

                                    </button>

                                </form>

                            </div>
                        
                        </td>

                    </tr>

                    stt++;
                }

            </tbody>

        </table>

    </div>
    @if (Model.PageCount > 1)
    {
        <div class="row align-items-center mt-4">

            <!-- INFORMATION -->
            <div class="col-md-4">

                <div class="text-muted small">

                    Showing
                    <strong>@Model.FirstItemOnPage</strong>
                    -
                    <strong>@Model.LastItemOnPage</strong>

                    of

                    <strong>@Model.TotalItemCount</strong>

                    receipts

                </div>

            </div>


            <!-- PAGINATION -->
            <div class="col-md-4">

                <nav aria-label="Stock receipt pagination">

                    <ul class="pagination justify-content-center mb-0">

                        <!-- FIRST -->
                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="1"
                               asp-route-search="@ViewBag.Search">

                                &lt;&lt;

                            </a>

                        </li>


                        <!-- PREVIOUS -->
                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.PageNumber - 1)"
                               asp-route-search="@ViewBag.Search">

                                Previous

                            </a>

                        </li>


                        @{
                            int currentPage = Model.PageNumber;
                            int totalPages = Model.PageCount;

                            int startPage;
                            int endPage;

                            if (totalPages <= 5)
                            {
                                startPage = 1;
                                endPage = totalPages;
                            }
                            else if (currentPage <= 3)
                            {
                                startPage = 1;
                                endPage = 5;
                            }
                            else if (currentPage >= totalPages - 2)
                            {
                                startPage = totalPages - 4;
                                endPage = totalPages;
                            }
                            else
                            {
                                startPage = currentPage - 2;
                                endPage = currentPage + 2;
                            }
                        }


                        <!-- FIRST PAGE + ELLIPSIS -->
                        @if (startPage > 1)
                        {
                            <li class="page-item">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="1"
                                   asp-route-search="@ViewBag.Search">

                                    1

                                </a>

                            </li>

                            @if (startPage > 2)
                            {
                                <li class="page-item disabled">

                                    <span class="page-link">
                                        ...
                                    </span>

                                </li>
                            }
                        }


                        <!-- PAGE NUMBERS -->
                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-search="@ViewBag.Search">

                                    @i

                                </a>

                            </li>
                        }


                        <!-- LAST PAGE + ELLIPSIS -->
                        @if (endPage < totalPages)
                        {
                            @if (endPage < totalPages - 1)
                            {
                                <li class="page-item disabled">

                                    <span class="page-link">
                                        ...
                                    </span>

                                </li>
                            }

                            <li class="page-item">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@totalPages"
                                   asp-route-search="@ViewBag.Search">

                                    @totalPages

                                </a>

                            </li>
                        }


                        <!-- NEXT -->

                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(currentPage + 1)"
                               asp-route-search="@ViewBag.Search">

                                Next

                            </a>

                        </li>


                        <!-- LAST -->

                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@totalPages"
                               asp-route-search="@ViewBag.Search">

                                &gt;&gt;

                            </a>

                        </li>

                    </ul>

                </nav>

            </div>


            <!-- EMPTY RIGHT COLUMN -->
            <div class="col-md-4">
            </div>

        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">

            <i class="fas fa-box-open fa-3x text-muted mb-3"></i>

            <h5>

                No stock receipts

            </h5>

            <p class="text-muted">

                There are currently no stock-in receipts.

            </p>


            <a asp-action="Create"
               class="btn btn-primary">

                <i class="fas fa-plus me-1"></i>

                Create First Receipt

            </a>

        </div>
    }

</div>

  @section Scripts {

    <script>

        function deleteReceipt(id, code) {

            Swal.fire({

                    title: "Delete Stock Receipt?",

                    html:
                        "Receipt <b>" + code + "</b> will be deleted.<br>" +
                        "<span class='text-danger'>" +
                        "The imported stock will also be removed from inventory." +
                        "</span>",

                    icon: "warning",

                    showCancelButton: true,

                    confirmButtonText: "Yes, delete it",

                    cancelButtonText: "Cancel",

                    confirmButtonColor: "#dc3545"

                }).then((result) => {

                    if (!result.isConfirmed)
                        return;

                    document.getElementById(
                        "deleteReceiptId"
                    ).value = id;

                    document.getElementById(
                        "deleteReceiptForm"
                    ).submit();

                });

            }

</script>                              
}

 <style>
    .pagination {
        gap: 4px;
    }

        .pagination .page-item {
            margin: 0;
        }

        .pagination .page-link {
            border: 1px solid #e5e7eb;
            border-radius: 8px !important;
            min-width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #374151;
            background-color: #fff;
            font-size: 14px;
            font-weight: 500;
            padding: 0 10px;
            transition: all 0.2s ease;
        }

            .pagination .page-link:hover {
                background-color: #f3f4f6;
                color: #0d6efd;
            }

        .pagination .page-item.active .page-link {
            background-color: #0d6efd;
            border-color: #0d6efd;
            color: #fff;
        }

        .pagination .page-item.disabled .page-link {
            background-color: #f8f9fa;
            color: #9ca3af;
            border-color: #e5e7eb;
            cursor: not-allowed;
        }
 </style>                 