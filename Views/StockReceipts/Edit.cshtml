@model LibraryManagement.ViewModels.StockReceiptEditVM

@{
    ViewData["Title"] = "Edit Stock Receipt";
}

<div class="page-card mb-4">

    <div class="d-flex justify-content-between align-items-center">

        <div>
            <div class="page-title">
                <i class="fas fa-pen-to-square text-primary me-2"></i>
                Edit Stock Receipt
            </div>

            <div class="page-subtitle">
                Update stock receipt information
            </div>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="fas fa-arrow-left me-1"></i>
            Back

        </a>

    </div>

</div>


<form asp-action="Edit"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           asp-for="Id" />

    <input type="hidden"
           asp-for="ReceiptCode" />

    <input type="hidden"
           asp-for="CreatedBy" />


    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>


    <!-- RECEIPT INFORMATION -->

    <div class="page-card mb-4">

        <div class="card-header bg-primary text-white mb-3">

            <h5 class="mb-0">
                <i class="fas fa-file-invoice me-2"></i>
                Receipt Information
            </h5>

        </div>


        <div class="row g-3">

            <div class="col-md-4">

                <label asp-for="ReceiptCode"
                       class="form-label fw-semibold">
                    Receipt Code
                </label>

                <input asp-for="ReceiptCode"
                       class="form-control"
                       readonly />

            </div>


            <div class="col-md-4">

                <label asp-for="ReceiptDate"
                       class="form-label fw-semibold">
                    Receipt Date
                </label>

                <input asp-for="ReceiptDate"
                       type="datetime-local"
                       class="form-control" />

                <span asp-validation-for="ReceiptDate"
                      class="text-danger">
                </span>

            </div>


            <div class="col-md-4">

                <label asp-for="SupplierId"
                       class="form-label fw-semibold">
                    Supplier
                </label>

                <select asp-for="SupplierId"
                        class="form-select">

                    <option value="">
                        -- Select Supplier --
                    </option>

                    @foreach (var supplier in ViewBag.Suppliers)
                    {
                        <option value="@supplier.Id">

                            @supplier.Name

                        </option>
                    }

                </select>

                <span asp-validation-for="SupplierId"
                      class="text-danger">
                </span>

            </div>

        </div>


        <div class="mt-3">

            <label asp-for="Note"
                   class="form-label fw-semibold">
                Note
            </label>

            <textarea asp-for="Note"
                      class="form-control"
                      rows="3"
                      placeholder="Optional note...">
            </textarea>

        </div>

    </div>


    <!-- BOOK DETAILS -->

    <div class="page-card mb-4">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <div>
                <h5 class="mb-1">

                    <i class="fas fa-books text-primary me-2"></i>

                    Stock Receipt Details

                </h5>

                <small class="text-muted">
                    Update imported books and quantities
                </small>
            </div>

        </div>


        <div class="table-responsive">

            <table class="table table-bordered align-middle">

                <thead class="table-dark">

                    <tr>

                        <th width="40">
                            #
                        </th>

                        <th>
                            Book
                        </th>

                        <th width="150">
                            Quantity
                        </th>

                        <th width="180">
                            Unit Price
                        </th>

                        <th width="180">
                            Amount
                        </th>

                    </tr>

                </thead>


                <tbody id="detailsContainer">

                    @for (int i = 0;
                                        i < Model.Details.Count;
                                        i++)
                    {
                        <tr>

                            <td>
                                @(i + 1)

                                <input type="hidden"
                                       asp-for="Details[i].Id" />

                            </td>


                            <td>

                                <select asp-for="Details[i].BookId"
                                        class="form-select">

                                    @foreach (var book in ViewBag.Books)
                                    {
                                        <option value="@book.Id">

                                            @book.Title

                                        </option>
                                    }

                                </select>

                            </td>


                            <td>

                                <input asp-for="Details[i].Quantity"
                                       class="form-control quantity-input"
                                       min="1"
                                       type="number" />

                            </td>


                            <td>

                                <input asp-for="Details[i].UnitPrice"
                                       class="form-control price-input"
                                       min="0"
                                       step="1000"
                                       type="number" />

                            </td>


                            <td>

                                <span class="amount-display fw-bold">
                                    0 VNĐ
                                </span>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>


    <!-- ACTION -->

    <div class="d-flex justify-content-end gap-2 mb-4">

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="fas fa-xmark me-1"></i>
            Cancel

        </a>


        <button type="submit"
                class="btn btn-primary">

            <i class="fas fa-save me-1"></i>
            Save Changes

        </button>

    </div>

</form>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        function calculateAmounts() {

            const rows =
                document.querySelectorAll(
                    "#detailsContainer tr"
                );

            rows.forEach(row => {

                const quantity =
                    row.querySelector(
                        ".quantity-input"
                    );

                const price =
                    row.querySelector(
                        ".price-input"
                    );

                const amount =
                    row.querySelector(
                        ".amount-display"
                    );

                if (!quantity ||
                    !price ||
                    !amount)
                    return;

                const qty =
                    parseFloat(quantity.value) || 0;

                const unitPrice =
                    parseFloat(price.value) || 0;

                const total =
                    qty * unitPrice;

                amount.textContent =
                    total.toLocaleString("vi-VN")
                    + " VNĐ";

            });

        }


        document.addEventListener(
            "input",
            function (e) {

                if (
                    e.target.classList.contains(
                        "quantity-input"
                    ) ||
                    e.target.classList.contains(
                        "price-input"
                    )
                ) {

                    calculateAmounts();

                }

            }
        );


        document.addEventListener(
            "DOMContentLoaded",
            function () {

                calculateAmounts();

            }
        );

    </script>
}