@model LibraryManagement.ViewModels.BorrowCreateVM

@{
    ViewData["Title"] = "Borrow Books";
    var books = ViewBag.Books as List<LibraryManagement.Models.Book>;
}

<div class="container-fluid">

    <div class="card shadow border-0">

        <div class="card-header bg-primary text-white">

            <h3 class="mb-0">

                <i class="fas fa-book-reader"></i>

                Borrow Books

            </h3>

        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <div class="col-md-6">

                        <label class="form-label">

                            Borrower Name

                        </label>

                        <input asp-for="BorrowerName"
                               class="form-control" />

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">

                            Email

                        </label>

                        <input asp-for="BorrowerEmail"
                               class="form-control" />

                    </div>

                </div>

                <div class="row mt-3">

                    <div class="col-md-6">

                        <label>Borrow Date</label>

                        <input asp-for="BorrowDate"
                               class="form-control" />

                    </div>

                    <div class="col-md-6">

                        <label>Due Date</label>

                        <input asp-for="DueDate"
                               class="form-control" />

                    </div>

                </div>

                <hr />

                <div class="row">

                    <div class="col-md-7">

                        <label>Book</label>

                        <select id="bookSelect"
                                class="form-select">

                            @foreach (var item in books)
                            {
                                <option value="@item.Id"
                                        data-title="@item.Title">

                                    @item.Title
                                    (@item.AvailableQuantity)

                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-md-3">

                        <label>Quantity</label>

                        <input id="qty"
                               type="number"
                               value="1"
                               min="1"
                               class="form-control" />

                    </div>

                    <div class="col-md-2 d-flex align-items-end">

                        <button type="button"
                                id="btnAdd"
                                class="btn btn-success w-100">

                            <i class="fas fa-plus"></i>

                        </button>

                    </div>

                </div>

                <hr />

                <div class="table-responsive">

                    <table class="table table-hover table-bordered align-middle">

                        <thead class="table-primary">

                            <tr>

                                <th>Book</th>

                                <th width="120">

                                    Qty

                                </th>

                                <th width="90">

                                </th>

                            </tr>

                        </thead>

                        <tbody id="borrowTable">
                        </tbody>

                    </table>

                </div>

                <div id="hiddenInputs">
                </div>

                <div class="text-end">

                    <button class="btn btn-primary btn-lg">

                        <i class="fas fa-save"></i>

                        Borrow

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        let index=0;

        $("#btnAdd").click(function(){

            let id=$("#bookSelect").val();

            let title=$("#bookSelect option:selected").data("title");

            let qty=$("#qty").val();

            let row=`

        <tr id="r${index}">

        <td>${title}</td>

        <td>${qty}</td>

        <td>

        <button
        type="button"
        class="btn btn-danger btn-sm"

        onclick="removeRow(${index})">

        <i class="fas fa-trash"></i>

        </button>

        </td>

        </tr>

        `;

            $("#borrowTable").append(row);
        let hidden=`

        <div id="hidden${index}">

        <input
        type="hidden"
        name="Items[${index}].BookId"
        value="${id}"/>

        <input
        type="hidden"
        name="Items[${index}].Quantity"
        value="${qty}"/>

        </div>

        `;

            $("#hiddenInputs").append(hidden);

            index++;

        });

              function removeRow(i){

            $("#r"+i).remove();

            $("#hidden"+i).remove();

        }
    </script>

}

<style>

    .page-card {
        background: #fff;
        border-radius: 14px;
        padding: 24px;
        margin-bottom: 20px;
        box-shadow: 0 4px 12px rgba(0,0,0,.08);
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
    }

    .page-subtitle {
        color: #6c757d;
        margin-top: 4px;
    }

    .card {
        border-radius: 16px;
    }

    .form-label {
        color: #444;
        margin-bottom: 8px;
    }

    .form-control,
    .form-select {
        border-radius: 10px;
        padding: 10px 14px;
        transition: .25s;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .18rem rgba(13,110,253,.15);
        }

    .btn {
        border-radius: 10px;
        padding: 10px 18px;
        font-weight: 600;
    }

    .btn-success {
        background: #198754;
        border: none;
    }

        .btn-success:hover {
            transform: translateY(-2px);
            transition: .2s;
        }

    .btn-outline-secondary:hover {
        transform: translateY(-2px);
        transition: .2s;
    }

    #stockText {
        font-size: 28px;
        font-weight: 700;
    }

    .card.border-success {
        border-width: 2px !important;
    }

    input[type=date] {
        cursor: pointer;
    }

    input[readonly] {
        background: #f8f9fa;
    }

    .alert {
        border-radius: 10px;
    }

    .text-danger {
        font-size: .9rem;
    }

    @@media(max-width:992px) {

        .page-title {
            font-size: 22px;
        }

        .card-body {
            padding: 18px !important;
        }
    }

    @@media(max-width:768px) {

        .text-end {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

            .text-end .btn {
                width: 100%;
            }

        #stockText {
            font-size: 22px;
        }
    }

    @@media(max-width:576px) {

        .page-card {
            padding: 18px;
        }

        .page-title {
            font-size: 20px;
        }

        .page-subtitle {
            font-size: 13px;
        }
    }

</style>