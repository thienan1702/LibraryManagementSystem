@model LibraryManagement.Models.Borrow
@using LibraryManagement.Models

@{
    ViewData["Title"] = "Borrow Book";
    var books = ViewBag.Books as List<LibraryManagement.Models.Book>;
    var users = ViewBag.Users as List<LibraryManagement.Models.ApplicationUser>;
}

<div class="page-card mb-4">

    <div class="d-flex justify-content-between align-items-center">

        <div>

            <div class="page-title">
                <i class="fas fa-book-reader text-primary me-2"></i>
                Borrow Book
            </div>

            <div class="page-subtitle">
                Create a new borrowing transaction
            </div>

        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">

            <i class="fas fa-arrow-left"></i>

            Back

        </a>

    </div>

</div>

<div class="card shadow-sm border-0">

    <div class="card-body p-4">

        <form asp-controller="Borrows"
              asp-action="Create"
              method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"></div>

            <div class="row">

                <div class="col-md-6">

                    <div class="mb-3">

                        <label asp-for="BorrowerName"
                               class="form-label fw-bold">

                            Customer Name

                        </label>

                        <input asp-for="BorrowerName"
                               class="form-control"
                               placeholder="Enter customer name" />

                        <span asp-validation-for="BorrowerName"
                              class="text-danger"></span>

                    </div>

                </div>

            <div class="row">

                    <div class="col-md-6">

                        <div class="mb-3">

                            <label asp-for="BorrowerEmail"
                                   class="form-label fw-bold">

                                Email

                            </label>

                            <input asp-for="BorrowerEmail"
                                   class="form-control"
                                   placeholder="example@gmail.com" />

                            <span asp-validation-for="BorrowerEmail"
                                  class="text-danger"></span>

                        </div>

                    </div>

                <div class="col-md-6">

                    <div class="mb-3">

                        <label class="form-label fw-bold">

                            Book

                        </label>

                        <select name="BookId"
                                id="BookSelect"
                                class="form-select">

                            @foreach (var book in books)
                            {
                                <option value="@book.Id"
                                        data-stock="@book.AvailableQuantity">

                                    @book.Title

                                </option>
                            }

                        </select>

                    </div>

                </div>

            </div>

                <div class="row mt-2">

                    <div class="col-md-4">

                        <div class="card border-success h-100">

                            <div class="card-body text-center">

                                <small class="text-muted">

                                    Available

                                </small>

                                <h3 id="stockText"
                                    class="text-success mt-2">
                                </h3>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="mb-3">

                            <label class="form-label fw-bold">

                                Quantity

                            </label>

                            <input type="number"
                                   id="Quantity"
                                   name="Quantity"
                                   class="form-control"
                                   value="1"
                                   min="1" />

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="alert alert-info mb-0">

                            <i class="fas fa-envelope"></i>

                            Confirmation email will be sent automatically after creating the borrow transaction.

                        </div>

                    </div>

                </div>

                <div class="col-md-3">

                    <div class="mb-3">

                        <label asp-for="BorrowDate"
                               class="form-label fw-bold"></label>

                        <input asp-for="BorrowDate"
                               type="date"
                               class="form-control" />

                    </div>

                </div>

                <div class="col-md-3">

                    <div class="mb-3">

                        <label asp-for="DueDate"
                               class="form-label fw-bold"></label>

                        <input asp-for="DueDate"
                               type="date"
                               class="form-control" />

                    </div>

                </div>

            </div>



            <hr />

            <div class="text-end">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    Cancel

                </a>

                <button type="submit" class="btn btn-success">
                    <i class="fas fa-book"></i> Borrow Book
                </button>

            </div>

        </form>

    </div>

</div>
@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        function updateStock(){

            let select=document.getElementById("BookSelect");

            let stock=select.options[select.selectedIndex]
                            .getAttribute("data-stock");

            document.getElementById("stockText").innerHTML=
                stock+" copies";

            if(parseInt(stock)==0){

                document.getElementById("stockText")
                .className="text-danger";

            }
            else{

                document.getElementById("stockText")
                .className="text-success";

            }

            document.getElementById("Quantity").max=stock;

        }

        updateStock();

        document.getElementById("BookSelect")
            .addEventListener("change",updateStock);


        document.getElementById("BorrowerEmail")
        .addEventListener("blur",function(){

            let email=this.value;

            if(email=="") return;

            fetch("/Borrows/GetBorrowerInfo?email="+encodeURIComponent(email))
            .then(r=>r.json())
            .then(data=>{

                if(data.exists){

                    Swal.fire({

                        toast:true,

                        timer:2500,

                        position:"top-end",

                        icon:"info",

                        title:
                        "Customer has borrowed "+
                        data.totalBorrow+
                        " time(s)."

                    });

                }

            });

        });

        document.getElementById("Quantity")
        .addEventListener("input",function(){

            let max=parseInt(this.max);

            if(parseInt(this.value)>max){

                Swal.fire({

                    icon:"warning",

                    title:"Quantity exceeds stock",

                    text:"Only "+max+" book(s) available."

                });

                this.value=max;

            }

            if(parseInt(this.value)<=0){

                this.value=1;

            }

        });






        window.onload=function(){

            let today=new Date();

            let yyyy=today.getFullYear();

            let mm=String(today.getMonth()+1).padStart(2,'0');

            let dd=String(today.getDate()).padStart(2,'0');

            let borrow=yyyy+"-"+mm+"-"+dd;

            document.getElementById("BorrowDate").value=borrow;

            let due=new Date();

            due.setDate(due.getDate()+7);

            let dyyyy=due.getFullYear();

            let dmm=String(due.getMonth()+1).padStart(2,'0');

            let ddd=String(due.getDate()).padStart(2,'0');

            document.getElementById("DueDate").value=
                dyyyy+"-"+dmm+"-"+ddd;

        };



        document.querySelector("form")
        .addEventListener("submit",function(e){

            let stock=parseInt(
                document.getElementById("BookSelect")
                .options[
                    document.getElementById("BookSelect").selectedIndex
                ].getAttribute("data-stock")
            );

            let qty=parseInt(
                document.getElementById("Quantity").value
            );

            if(qty>stock){

                e.preventDefault();

                Swal.fire({

                    icon:"error",

                    title:"Not enough books",

                    text:"Please reduce quantity."

                });

            }

        });

    </script>

}

<style>

    .page-card {
        background: #fff;
        border-radius: 14px;
        padding: 24px;
        margin-bottom: 20px;
        box-shadow: 0 4px 12px rgba(0,0,0,.08);
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
    }

    .page-subtitle {
        color: #6c757d;
        margin-top: 4px;
    }

    .card {
        border-radius: 16px;
    }

    .form-label {
        color: #444;
        margin-bottom: 8px;
    }

    .form-control,
    .form-select {
        border-radius: 10px;
        padding: 10px 14px;
        transition: .25s;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .18rem rgba(13,110,253,.15);
        }

    .btn {
        border-radius: 10px;
        padding: 10px 18px;
        font-weight: 600;
    }

    .btn-success {
        background: #198754;
        border: none;
    }

        .btn-success:hover {
            transform: translateY(-2px);
            transition: .2s;
        }

    .btn-outline-secondary:hover {
        transform: translateY(-2px);
        transition: .2s;
    }

    #stockText {
        font-size: 28px;
        font-weight: 700;
    }

    .card.border-success {
        border-width: 2px !important;
    }

    input[type=date] {
        cursor: pointer;
    }

    input[readonly] {
        background: #f8f9fa;
    }

    .alert {
        border-radius: 10px;
    }

    .text-danger {
        font-size: .9rem;
    }

    @@media(max-width:992px) {

        .page-title {
            font-size: 22px;
        }

        .card-body {
            padding: 18px !important;
        }
    }

    @@media(max-width:768px) {

        .text-end {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

            .text-end .btn {
                width: 100%;
            }

        #stockText {
            font-size: 22px;
        }
    }

    @@media(max-width:576px) {

        .page-card {
            padding: 18px;
        }

        .page-title {
            font-size: 20px;
        }

        .page-subtitle {
            font-size: 13px;
        }
    }

</style>