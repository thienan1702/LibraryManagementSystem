@model  LibraryManagement.ViewModels.BorrowCreateVM

@{
    ViewData["Title"] = "Borrow Books";
    var books = ViewBag.Books as List<LibraryManagement.Models.Book>;
}

<div class="container py-4">

    <div class="page-card mb-4">

        <div class="d-flex justify-content-between align-items-center">

            <div>

                <div class="page-title">

                    <i class="fas fa-book-reader text-primary"></i>

                    Borrow Books

                </div>

                <div class="page-subtitle">

                    Create a borrowing slip with multiple books

                </div>

            </div>

            <a asp-action="Index" class="btn btn-outline-secondary">

                <i class="fas fa-arrow-left"></i>

                Back

            </a>

        </div>

    </div>


    <div class="card shadow-sm mb-4">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">
                <i class="fas fa-barcode"></i>
                Scan / Enter ISBN
            </h5>

        </div>

        <div class="card-body">

            <div class="input-group">

                <input id="isbnInput"
                       class="form-control form-control-lg"
                       placeholder="Scan barcode or enter ISBN..." />

                <button id="btnSearchBook"
                        type="button"
                        class="btn btn-primary">

                    <i class="fas fa-search"></i>

                </button>

            </div>

        </div>

        <div class="mt-3">

            <button type="button"
                    id="btnCamera"
                    class="btn btn-success">

                <i class="fas fa-camera"></i>

                Scan by Camera

            </button>

        </div>

        <div id="reader"
             style="width:400px;display:none;"
             class="mt-3">
        </div>

    </div>
    <div id="bookInfo"
         class="card shadow-sm mb-4"
         style="display:none;">

        <div class="card-body">

            <div class="row">

                <div class="col-md-3 text-center">

                    <img id="bookImage"
                         class="img-fluid rounded border"
                         style="max-height:180px;" />

                </div>

                <div class="col-md-9">

                    <h4 id="bookTitle"></h4>

                    <table class="table">

                        <tr>
                            <th>ISBN</th>
                            <td id="bookISBN"></td>
                        </tr>

                        <tr>
                            <th>Author</th>
                            <td id="bookAuthor"></td>
                        </tr>

                        <tr>
                            <th>Category</th>
                            <td id="bookCategory"></td>
                        </tr>

                        <tr>
                            <th>Publisher</th>
                            <td id="bookPublisher"></td>
                        </tr>

                        <tr>
                            <th>Available</th>
                            <td id="bookAvailable"></td>
                        </tr>

                    </table>

                </div>

            </div>

        </div>

    </div>


    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"></div>

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-primary text-white">

                <i class="fas fa-user"></i>

                Borrower Information

            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="BorrowerName"
                               class="form-label"></label>

                        <input asp-for="BorrowerName"
                               class="form-control"/>

                        <span asp-validation-for="BorrowerName"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="BorrowerEmail"
                               class="form-label"></label>

                        <input asp-for="BorrowerEmail"
                               class="form-control"/>

                        <span asp-validation-for="BorrowerEmail"
                              class="text-danger"></span>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6">

                        <label asp-for="BorrowDate"
                               class="form-label"></label>

                        <input asp-for="BorrowDate"
                               class="form-control"/>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="DueDate"
                               class="form-label"></label>

                        <input asp-for="DueDate"
                               class="form-control"/>

                    </div>

                </div>

            </div>

        </div>

        <div class="row mb-4">

            <div class="col-md-3">

                <div class="card border-primary">

                    <div class="card-body text-center">

                        <h2 id="bookCount">0</h2>

                        <div>Books</div>

                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card border-success">

                    <div class="card-body text-center">

                        <h2 id="totalQty">0</h2>

                        <div>Total Quantity</div>

                    </div>

                </div>

            </div>

        </div>

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-success text-white">

                <i class="fas fa-plus-circle"></i>

                Add Book

            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-8">

                        <label class="form-label">

                            Book

                        </label>

                        <select id="bookSelect"
                                class="form-select select-book">

                            <option value="">

                                Select Book

                            </option>

                            @foreach (var book in books)
                            {
                                <option value="@book.Id"
                                        data-isbn="@book.ISBN"
                                        data-title="@book.Title"
                                        data-author="@book.Author?.Name"
                                        data-category="@book.Category?.Name"
                                        data-publisher="@book.Publisher?.Name"
                                        data-image="@book.ImageUrl"
                                        data-available="@book.AvailableQuantity">

                                    @book.Title (@book.AvailableQuantity)

                                </option>
                            }
                        </select>

                    </div>

                    <div class="col-md-2">

                        <label class="form-label">

                            Quantity

                        </label>

                        <input
                            id="qty"
                            type="number"
                            class="form-control"
                            min="1"
                            value="1"/>

                    </div>

                    <div class="col-md-2 d-grid">

                        <label>&nbsp;</label>

                        <button
                            type="button"
                            id="btnAdd"
                            class="btn btn-success">

                            <i class="fas fa-plus"></i>

                            Add

                        </button>

                    </div>

                </div>

            </div>

        </div>

        <div class="card shadow">

            <div class="card-header bg-dark text-white">

                <i class="fas fa-list"></i>

                Borrow List

            </div>

            <div class="card-body p-0">

                <table class="table table-hover mb-0">

                    <thead class="table-light">

                        <tr>

                            <th width="60">#</th>

                            <th>Book</th>

                            <th width="170">Quantity</th>

                            <th width="120">Action</th>

                        </tr>

                    </thead>

                    <tbody id="borrowTable">

                    </tbody>

                </table>

            </div>

        </div>

        <div id="hiddenArea"></div>

        <div class="text-end mt-4">

            <button
                class="btn btn-success btn-lg px-5">

                <i class="fas fa-save"></i>

                Create Borrow

            </button>

        </div>

    </form>

</div>


<audio id="beepSound">
    <source src="https://actions.google.com/sounds/v1/cartoon/pop.ogg" type="audio/ogg">
</audio>



@section Scripts {

    <partial name="_ValidationScriptsPartial" />




    <script>

                function playBeep() {

            document.getElementById("beepSound").play();

        }

        let index = 0;

        let selectedBooks = [];

        $(function () {

            $(".select-book").select2({
                width: "100%",
                placeholder: "Search book..."
            });

            $("#btnAdd").click(function () {

                addBook();

            });

        });

        function updateSummary() {

            $("#bookCount").text(selectedBooks.length);

            let total = 0;

            $("input[id^='qtyHidden']").each(function () {

                total += parseInt($(this).val()) || 0;

            });

            $("#totalQty").text(total);

        }

        function addBook() {

            let id = $("#bookSelect").val();

            if (id == "") {

                alert("Please select a book.");

                return;

            }

            id = parseInt(id);

            if (selectedBooks.includes(id)) {

                alert("This book has already been selected.");

                return;

            }

            let title = $("#bookSelect option:selected").text();

            let qty = parseInt($("#qty").val());

            if (qty <= 0 || isNaN(qty)) {

                alert("Quantity must be greater than zero.");

                return;

            }

            selectedBooks.push(id);

            let row = `
        <tr id="row${index}">

        <td class="text-center">

        ${index + 1}

        </td>

        <td>

        ${title}

        </td>

        <td>

        <div class="input-group input-group-sm">

        <button
        type="button"
        class="btn btn-outline-secondary"

        onclick="minus(${index})">

        -

        </button>

        <input
        type="text"
        class="form-control text-center"

        id="qtyDisplay${index}"

        value="${qty}"

        readonly/>

        <button
        type="button"
        class="btn btn-outline-secondary"

        onclick="plus(${index})">

        +

        </button>

        </div>

        </td>

        <td class="text-center">

        <button

        type="button"

        class="btn btn-danger btn-sm"

        onclick="removeBook(${index},${id})">

        <i class="fas fa-trash"></i>

        </button>

        </td>

        </tr>
        `;

            $("#borrowTable").append(row);

            $("#hiddenArea").append(`

        <div id="hidden${index}">

        <input

        type="hidden"

        name="Items[${index}].BookId"

        value="${id}"/>

        <input

        type="hidden"

        name="Items[${index}].Quantity"

        id="qtyHidden${index}"

        value="${qty}"/>

        </div>

        `);

            index++;

            updateSummary();

        }

        function plus(i){

            let value=parseInt($("#qtyHidden"+i).val());

            value++;

            $("#qtyHidden"+i).val(value);

            $("#qtyDisplay"+i).val(value);

            updateSummary();

        }

        function minus(i){

            let value=parseInt($("#qtyHidden"+i).val());

            if(value>1){

                value--;

                $("#qtyHidden"+i).val(value);

                $("#qtyDisplay"+i).val(value);

            }

            updateSummary();

        }

        function removeBook(i,id){

            $("#row"+i).remove();

            $("#hidden"+i).remove();

            selectedBooks = selectedBooks.filter(x=>x!=id);

            updateSummary();

        }

                $("#btnSearchBook").click(function () {

            let isbn = $("#isbnInput").val().trim();

            if (isbn === "")
                return;

            let option = $("#bookSelect option").filter(function () {

                return $(this).data("isbn") == isbn;

            });

            if (option.length == 0) {

                Swal.fire(
                    "Not found",
                    "Book not found.",
                    "error");

                return;
            }

            $("#bookSelect").val(option.val());

            $("#bookInfo").show();

            $("#bookTitle").text(option.data("title"));

            $("#bookISBN").text(option.data("isbn"));

            $("#bookAuthor").text(option.data("author"));

            $("#bookCategory").text(option.data("category"));

            $("#bookPublisher").text(option.data("publisher"));

            $("#bookAvailable").text(option.data("available"));

            $("#bookImage").attr("src", option.data("image"));

            $("#btnAdd").click();



        });
                $("#isbnInput").keypress(function (e) {

            if (e.which == 13) {

                e.preventDefault();

                $("#btnSearchBook").click();

                playBeep();

            }

        });



                let html5QrCode;

        $("#btnCamera").click(function () {

            $("#reader").show();

            html5QrCode = new Html5Qrcode("reader");

            html5QrCode.start(
                { facingMode: "environment" },
                {
                    fps: 10,
                    qrbox: 250
                },

                function (decodedText) {

        $("#isbnInput").val(decodedText);

        $("#btnSearchBook").click();

        $("#btnAdd").click();
                Swal.fire({

            toast: true,

            position: "top-end",

            icon: "success",

            title: "Book Added",

            showConfirmButton: false,

            timer: 1200

        });

        playBeep();

        html5QrCode.stop();

        $("#reader").hide();
        
        $("#isbnInput").val("");

        $("#isbnInput").focus();

                },

                function () {

                }

            );

        });






    </script>


}
<style>

    body {
        background: #f5f7fb;
    }

    /*==============================
        PAGE
    ==============================*/

    .page-card {
        background: white;
        border-radius: 20px;
        padding: 25px 30px;
        box-shadow: 0 10px 25px rgba(0,0,0,.08);
    }

    .page-title {
        font-size: 30px;
        font-weight: 700;
        color: #1b1b1b;
    }

    .page-subtitle {
        color: #6c757d;
        margin-top: 6px;
    }

    /*==============================
        CARD
    ==============================*/

    .card {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        transition: .3s;
        box-shadow: 0 5px 15px rgba(0,0,0,.06);
    }

        .card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,.10);
        }

    .card-header {
        font-size: 17px;
        font-weight: 600;
        padding: 14px 20px;
        border: none;
    }

    /*==============================
        INPUT
    ==============================*/

    .form-control,
    .form-select {
        border-radius: 12px;
        border: 1px solid #dcdcdc;
        padding: 11px 14px;
        transition: .25s;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .18rem rgba(13,110,253,.18);
        }

    .form-label {
        font-weight: 600;
        margin-bottom: 8px;
    }

    /*==============================
        BUTTON
    ==============================*/

    .btn {
        border-radius: 12px;
        transition: .25s;
        font-weight: 600;
    }

        .btn:hover {
            transform: translateY(-2px);
        }

    .btn-success {
        background: #16a34a;
        border: none;
    }

    .btn-primary {
        border: none;
    }

    .btn-danger {
        border: none;
    }

    /*==============================
        TABLE
    ==============================*/

    .table {
        margin-bottom: 0;
    }

        .table thead {
            background: #f3f6fb;
        }

            .table thead th {
                font-weight: 700;
                color: #444;
                border: none;
            }

        .table tbody td {
            vertical-align: middle;
        }

        .table tbody tr {
            transition: .25s;
        }

            .table tbody tr:hover {
                background: #f9fbff;
            }

    /*==============================
        SUMMARY
    ==============================*/

    .border-primary {
        border: 2px solid #0d6efd !important;
    }

    .border-success {
        border: 2px solid #16a34a !important;
    }

    #bookCount {
        color: #0d6efd;
        font-size: 40px;
        font-weight: 700;
    }

    #totalQty {
        color: #16a34a;
        font-size: 40px;
        font-weight: 700;
    }

    /*==============================
        SELECT2
    ==============================*/

    .select2-container--default .select2-selection--single {
        height: 46px;
        border-radius: 12px;
        border: 1px solid #dcdcdc;
    }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 44px;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 44px;
        }

    /*==============================
        PLUS MINUS
    ==============================*/

    .input-group-sm button {
        width: 42px;
    }

    .input-group-sm input {
        text-align: center;
        font-weight: 600;
    }

    /*==============================
        ALERT
    ==============================*/

    .alert {
        border-radius: 12px;
    }

    /*==============================
        RESPONSIVE
    ==============================*/

    @@media(max - width:768px) {
        .page-card

    {
        padding: 20px;
    }

    .page-title {
        font-size: 24px;
    }

    .text-end {
        text-align: center !important;
    }

        .text-end .btn {
            width: 100%;
        }

    }
</style>