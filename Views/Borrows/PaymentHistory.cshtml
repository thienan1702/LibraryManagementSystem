@using X.PagedList
@using X.PagedList.Mvc.Core

@model IPagedList<LibraryManagement.Models.FinePayment>
@{
    ViewData["Title"] = "Payment History";

    var total = Model.Sum(x => x.Amount);
    var cash = Model
        .Where(x => x.PaymentMethod == "Cash")
        .Sum(x => x.Amount);

    var transfer = Model
        .Where(x => x.PaymentMethod == "Bank Transfer")
        .Sum(x => x.Amount);
}

<div class="page-card mb-4">

    <div class="d-flex justify-content-between align-items-center">

        <div>

            <div class="page-title">

                <i class="fas fa-clock-rotate-left text-primary"></i>

                Payment History

            </div>

            <div class="page-subtitle">

                View all fine payment transactions

            </div>

        </div>

    </div>

</div>


<!-- Statistics -->

<div class="row mb-4">

    <div class="col-md-4">

        <div class="small-box bg-primary">

            <div class="inner">

                <h3>@ViewBag.TotalPayments</h3>

                <p>Total Payments</p>

            </div>

            <div class="icon">

                <i class="fas fa-receipt"></i>

            </div>

        </div>

    </div>


    <div class="col-md-4">

        <div class="small-box bg-success">

            <div class="inner">

                <h3>
                    @(((decimal)ViewBag.TotalAmount).ToString("N0")) đ
                </h3>

                <p>Total Collected</p>

            </div>

            <div class="icon">

                <i class="fas fa-money-bill-wave"></i>

            </div>

        </div>

    </div>


    <div class="col-md-4">

        <div class="small-box bg-info">

            <div class="inner">

                <h3>@Model.TotalItemCount</h3>

                <p>Total Transactions</p>

            </div>

            <div class="icon">

                <i class="fas fa-list"></i>

            </div>

        </div>

    </div>

</div>


<!-- Search -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-body">

        <form asp-action="PaymentHistory"
              method="get">

            <div class="row g-2">

                <div class="col-md-6">

                    <div class="input-group">

                        <span class="input-group-text">

                            <i class="fas fa-search"></i>

                        </span>

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Search customer, email, payment code..." />

                    </div>

                </div>


                <div class="col-md-3">

                    <select name="paymentMethod"
                            class="form-select">

                        <option value="">
                            All Payment Methods
                        </option>

                        <option value="Cash"
                                selected="@(ViewBag.PaymentMethod == "Cash")">

                            Cash

                        </option>

                        <option value="Bank Transfer"
                                selected="@(ViewBag.PaymentMethod == "Bank Transfer")">

                            Bank Transfer

                        </option>

                    </select>

                </div>


                <div class="col-md-3">

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="fas fa-search"></i>

                            Search

                        </button>

                        <a asp-action="PaymentHistory"
                           class="btn btn-secondary">

                            <i class="fas fa-rotate-left"></i>

                            Reset

                        </a>

                    </div>

                </div>

            </div>

        </form>

    </div>

</div>


<!-- Payment Table -->

<div class="card shadow-sm border-0">

    <div class="card-header">

        <h5 class="mb-0">

            <i class="fas fa-receipt text-primary me-2"></i>

            Payment Transactions

        </h5>

    </div>


    <div class="card-body p-0">

        @if (!Model.Any())
        {
            <div class="text-center py-5">

                <i class="fas fa-receipt fa-3x text-muted mb-3"></i>

                <h5>No payment history found</h5>

                <p class="text-muted mb-0">

                    Payment transactions will appear here.

                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-dark">

                        <tr>

                            <th width="60">#</th>

                            <th>Payment Code</th>

                            <th>Customer</th>

                            <th>Amount</th>

                            <th>Payment Method</th>

                            <th>Payment Date</th>

                            <th>Invoice</th>

                            <th>Paid By</th>

                        </tr>

                    </thead>


                    <tbody>

                        @{
                            int stt =
                            (Model.PageNumber - 1)
                            * Model.PageSize + 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    <span class="badge bg-primary">

                                        @stt

                                    </span>

                                </td>


                                <td>

                                    <strong class="text-primary">

                                        @item.PaymentCode

                                    </strong>

                                </td>


                                <td>

                                    <div class="d-flex align-items-center">

                                        <div class="avatar-circle">

                                            @(string.IsNullOrEmpty(item.CustomerName)
                                                                                ? "?"
                                                                                : item.CustomerName.Substring(0, 1).ToUpper())

                                </div>

                                        <div class="ms-2">

                                            <strong>

                                                @item.CustomerName

                                            </strong>

                                            <div class="small text-muted">

                                                @item.CustomerEmail

                                            </div>

                                        </div>

                                    </div>

                                </td>


                                <td>

                                    <strong class="text-success">

                                        @item.Amount.ToString("N0") đ

                                    </strong>

                                </td>


                                <td>

                            @if (item.PaymentMethod == "Cash")
                                    {
                                        <span class="badge bg-success">

                                            <i class="fas fa-money-bill-wave"></i>

                                            Cash

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">

                                            <i class="fas fa-building-columns"></i>

                                            Bank Transfer

                                        </span>
                                    }

                                </td>


                                <td>

                                    @item.PaymentDate.ToString(
                                    "dd/MM/yyyy HH:mm")

                        </td>


                        <td>

                            @if (!string.IsNullOrEmpty(item.InvoiceNumber))
                                    {
                                        <span class="badge bg-light text-dark border">

                                            <i class="fas fa-file-invoice"></i>

                                            @item.InvoiceNumber

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">

                                            N/A

                                        </span>
                                    }

                            </td>


                            <td>

                                <span class="badge bg-secondary">

                                    @(string.IsNullOrWhiteSpace(item.PaidBy)
                                                                    ? "System"
                                                                    : item.PaidBy)

                            </span>

                                </td>

                            </tr>

                                        stt++;
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>


<!-- Pagination -->
@if (Model.PageCount > 1)
{
    <div class="d-flex justify-content-center mt-4">

        @Html.PagedListPager(

        Model,

        page => Url.Action(
        "PaymentHistory",
        new
        {
            page,
            search = ViewBag.Search,
            paymentMethod = ViewBag.PaymentMethod
        }),

        new PagedListRenderOptions
        {
            DisplayLinkToFirstPage = PagedListDisplayMode.Always,

            DisplayLinkToLastPage = PagedListDisplayMode.Always,

            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,

            DisplayLinkToNextPage = PagedListDisplayMode.Always,

            LinkToFirstPageFormat = "<<",

            LinkToPreviousPageFormat = "Previous",

            LinkToNextPageFormat = "Next",

            LinkToLastPageFormat = ">>",

            MaximumPageNumbersToDisplay = 5,

            UlElementClasses = new[] { "pagination" },

            LiElementClasses = new[] { "page-item" },

            PageClasses = new[] { "page-link" }
        })

</div>
}