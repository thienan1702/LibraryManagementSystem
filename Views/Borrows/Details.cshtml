@model LibraryManagement.Models.Borrow

@{
    ViewData["Title"] = "Borrow Details";
}

<div class="container-fluid">

    <!-- HEADER -->
    <div class="page-card mb-4">

        <div class="d-flex justify-content-between align-items-center">

            <div>
                <div class="page-title">
                    <i class="fas fa-book-reader text-primary me-2"></i>
                    Borrow Details
                </div>

                <div class="page-subtitle">
                    View borrowing information and borrowed books
                </div>
            </div>

            <div>
                @if (Model.IsReturned)
                {
                    <span class="badge bg-success status-badge">
                        <i class="fas fa-circle-check me-1"></i>
                        Returned
                    </span>
                }
                else
                {
                    <span class="badge bg-warning text-dark status-badge">
                        <i class="fas fa-book-open me-1"></i>
                        Borrowing
                    </span>
                }
            </div>

        </div>

    </div>


    <!-- BORROW INFORMATION -->
    <div class="row mb-4">

        <!-- BORROWER -->
        <div class="col-lg-7 mb-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-primary text-white">

                    <i class="fas fa-user me-2"></i>

                    Borrower Information

                </div>

                <div class="card-body">

                    <div class="borrower-box">

                        <div class="avatar-large">

                            @(string.IsNullOrEmpty(Model.BorrowerName)
                                                        ? "?"
                                                        : Model.BorrowerName.Substring(0, 1).ToUpper())

                        </div>

                        <div class="borrower-info">

                            <h4 class="mb-1">
                                @Model.BorrowerName
                            </h4>

                            @if (!string.IsNullOrEmpty(Model.BorrowerEmail))
                            {
                                <div class="text-muted">

                                    <i class="fas fa-envelope me-2"></i>

                                    @Model.BorrowerEmail

                                </div>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- BORROW STATUS -->
        <div class="col-lg-5 mb-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-dark text-white">

                    <i class="fas fa-circle-info me-2"></i>

                    Borrow Information

                </div>

                <div class="card-body">

                    <div class="info-row">

                        <div>
                            <i class="fas fa-calendar-plus text-primary me-2"></i>
                            <span>Borrow Date</span>
                        </div>

                        <strong>
                            @Model.BorrowDate.ToString("dd/MM/yyyy")
                        </strong>

                    </div>


                    <div class="info-row">

                        <div>
                            <i class="fas fa-calendar-check text-success me-2"></i>
                            <span>Return Date</span>
                        </div>

                        <strong>

                            @(Model.ReturnDate?.ToString("dd/MM/yyyy") ?? "-")

                        </strong>

                    </div>


                    <div class="info-row">

                        <div>
                            <i class="fas fa-circle-dot text-warning me-2"></i>
                            <span>Status</span>
                        </div>

                        @if (Model.IsReturned)
                        {
                            <span class="badge bg-success">
                                Returned
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                Borrowing
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- BORROWED BOOKS -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">

            <div>

                <i class="fas fa-books me-2"></i>

                Borrowed Books

            </div>

            <span class="badge bg-light text-primary">

                @(Model.BorrowDetails?.Count() ?? 0) book(s)

            </span>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-dark">

                        <tr>

                            <th width="70" class="text-center">
                                #
                            </th>

                            <th>
                                <i class="fas fa-book me-1"></i>
                                Book
                            </th>

                            <th width="150" class="text-center">
                                <i class="fas fa-layer-group me-1"></i>
                                Quantity
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @{
                            int stt = 1;
                        }

                        @if (Model.BorrowDetails != null &&
                                                Model.BorrowDetails.Any())
                        {

                            foreach (var item in Model.BorrowDetails)
                            {

                                <tr>

                                    <td class="text-center">

                                        <span class="number-badge">
                                            @stt
                                        </span>

                                    </td>

                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="book-icon">

                                                <i class="fas fa-book"></i>

                                            </div>

                                            <div class="ms-3">

                                                <strong>
                                                    @(item.Book?.Title ?? "Unknown Book")
                                                </strong>

                                            </div>

                                        </div>

                                    </td>

                                    <td class="text-center">

                                        <span class="quantity-badge">

                                            @item.Quantity

                                        </span>

                                    </td>

                                </tr>

                                stt++;
                            }

                        }
                        else
                        {

                            <tr>

                                <td colspan="3"
                                    class="text-center py-5">

                                    <i class="fas fa-book-open fa-3x text-muted mb-3"></i>

                                    <h5>
                                        No books found
                                    </h5>

                                    <p class="text-muted mb-0">
                                        This borrowing record has no book details.
                                    </p>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- ACTIONS -->
    <div class="d-flex justify-content-between align-items-center">

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="fas fa-arrow-left me-1"></i>

            Back to List

        </a>


        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">

                <i class="fas fa-pen me-1"></i>

                Edit

            </a>

        </div>

    </div>

</div>


<style>

    /* =========================
           PAGE
        ========================= */

    .page-card {
        background: #fff;
        border-radius: 12px;
        padding: 20px 24px;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
    }

    .page-title {
        font-size: 24px;
        font-weight: 700;
    }

    .page-subtitle {
        color: #6c757d;
        margin-top: 4px;
    }


    /* =========================
           STATUS
        ========================= */

    .status-badge {
        padding: 9px 14px;
        font-size: 13px;
        border-radius: 20px;
    }


    /* =========================
           CARD
        ========================= */

    .card {
        border-radius: 12px;
        overflow: hidden;
    }

    .card-header {
        font-weight: 600;
        padding: 14px 18px;
    }


    /* =========================
           BORROWER
        ========================= */

    .borrower-box {
        display: flex;
        align-items: center;
        padding: 10px 5px;
    }

    .avatar-large {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e7f1ff;
        color: #0d6efd;
        font-size: 26px;
        font-weight: 700;
    }

    .borrower-info h4 {
        font-weight: 700;
    }


    /* =========================
           INFORMATION
        ========================= */

    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 13px 0;
        border-bottom: 1px solid #eee;
    }

        .info-row:last-child {
            border-bottom: none;
        }

        .info-row > div {
            color: #6c757d;
        }


    /* =========================
           TABLE
        ========================= */

    .table thead th {
        background: #343a40 !important;
        color: #fff !important;
        font-weight: 600;
        vertical-align: middle;
    }

    .table tbody tr {
        transition: .15s;
    }

        .table tbody tr:hover {
            background: #f8f9fa;
        }


    /* =========================
           BOOK ICON
        ========================= */

    .book-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e7f1ff;
        color: #0d6efd;
    }


    /* =========================
           NUMBER
        ========================= */

    .number-badge {
        display: inline-flex;
        width: 30px;
        height: 30px;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e7f1ff;
        color: #0d6efd;
        font-weight: 600;
    }


    /* =========================
           QUANTITY
        ========================= */

    .quantity-badge {
        display: inline-block;
        min-width: 42px;
        padding: 6px 12px;
        border-radius: 20px;
        background: #f1f3f5;
        font-weight: 600;
    }


    /* =========================
           BUTTON
        ========================= */

    .btn {
        border-radius: 8px;
        font-weight: 500;
    }

    .btn-warning {
        color: #212529;
    }

</style>