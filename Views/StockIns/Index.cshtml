@model IEnumerable<LibraryManagement.Models.StockIn>

@{
    ViewData["Title"] = "Stock In Management";
}

<div class="page-card mb-4">

    <div class="d-flex justify-content-between align-items-center">

        <div>

            <div class="page-title">

                <i class="fas fa-boxes-stacked text-primary"></i>

                Stock In Management

            </div>

            <div class="page-subtitle">

                Manage and view library inventory entries

            </div>

        </div>

        <a asp-action="Create"
           class="btn btn-app btn-add">

            <i class="fas fa-plus"></i>

            Stock In

        </a>

    </div>

</div>


<!-- Statistics -->

<div class="row mb-4">

    <div class="col-md-4">

        <div class="small-box bg-primary">

            <div class="inner">

                <h3>@Model.Count()</h3>

                <p>Total Stock-In Entries</p>

            </div>

            <div class="icon">

                <i class="fas fa-boxes-stacked"></i>

            </div>

        </div>

    </div>


    <div class="col-md-4">

        <div class="small-box bg-success">

            <div class="inner">

                <h3>
                    @Model.Sum(x => x.Quantity)
                </h3>

                <p>Total Books Stocked In</p>

            </div>

            <div class="icon">

                <i class="fas fa-book"></i>

            </div>

        </div>

    </div>


    <div class="col-md-4">

        <div class="small-box bg-info">

            <div class="inner">

                <h3>
                    @Model.Select(x => x.BookId).Distinct().Count()
                </h3>

                <p>Books Restocked</p>

            </div>

            <div class="icon">

                <i class="fas fa-book-open"></i>

            </div>

        </div>

    </div>

</div>


<!-- Table -->

<div class="card shadow-sm border-0">

    <div class="card-header">

        <div class="d-flex justify-content-between align-items-center">

            <h5 class="mb-0">

                <i class="fas fa-clock-rotate-left"></i>

                Stock-In History

            </h5>

        </div>

    </div>


    <div class="card-body p-0">

        @if (!Model.Any())
        {
            <div class="text-center py-5">

                <i class="fas fa-box-open fa-3x text-muted mb-3"></i>

                <h5>No stock-in records</h5>

                <p class="text-muted">

                    There are currently no inventory entries.

                </p>

                <a asp-action="Create"
                   class="btn btn-primary">

                    <i class="fas fa-plus"></i>

                    Stock In

                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-dark">

                        <tr>

                            <th width="70">
                                #
                            </th>

                            <th>
                                Book
                            </th>

                            <th>
                                Quantity
                            </th>

                            <th>
                                Stock In Date
                            </th>

                            <th>
                                Created By
                            </th>

                            <th>
                                Note
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @{
                            int stt = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    <span class="badge bg-primary">

                                        @stt

                                    </span>

                                </td>


                                <td>

                                    <div class="d-flex align-items-center">

                                        <div class="avatar-circle">

                                            <i class="fas fa-book"></i>

                                        </div>

                                        <div class="ms-2">

                                            <strong>
                                                @item.Book?.Title
                                            </strong>

                                            <div class="text-muted small">

                                                ISBN:
                                                @item.Book?.ISBN

                                            </div>

                                        </div>

                                    </div>

                                </td>


                                <td>

                                    <span class="badge bg-success fs-6">

                                        +@item.Quantity

                                    </span>

                                </td>


                                <td>

                                    <i class="far fa-calendar"></i>

                                    @item.StockInDate.ToString(
                                    "dd/MM/yyyy HH:mm")

                        </td>


                        <td>

                            <span class="badge bg-secondary">

                                @(string.IsNullOrWhiteSpace(item.CreatedBy)
                                                                ? "System"
                                                                : item.CreatedBy)

                            </span>

                                </td>


                                <td>

                            @if (!string.IsNullOrWhiteSpace(item.Note))
                                    {
                                        if (item.Note.Length > 80)
                                        {
                                            @item.Note.Substring(0, 80)

                                            <span>...</span>
                                        }
                                        else
                                        {
                                            @item.Note
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No note
                                        </span>
                                    }

                                </td>

                            </tr>

                            stt++;
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>