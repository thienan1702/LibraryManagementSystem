@model LibraryManagement.Models.Supplier

@{
    ViewData["Title"] = "Supplier Details";
}

<div class="page-card">

    <div class="d-flex justify-content-between align-items-center">

        <div>

            <div class="page-title">

                <i class="fas fa-truck-field text-primary me-2"></i>

                Supplier Details

            </div>

            <div class="page-subtitle">

                Detailed information about this supplier

            </div>

        </div>


     >
        <!-- ACTION -->

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">

                <i class="fas fa-pen me-1"></i>

                Edit Supplier

            </a>


            <a asp-action="Index"
               class="btn btn-secondary">

                <i class="fas fa-arrow-left me-1"></i>

                Back to Suppliers

            </a>

        </div>

    </div>

</div>


<div class="row">

    <!-- SUPPLIER INFORMATION -->

    <div class="col-md-6 mb-4">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-header bg-primary text-white">

                <h5 class="mb-0">

                    <i class="fas fa-building me-2"></i>

                    Supplier Information

                </h5>

            </div>


            <div class="card-body">

                <div class="mb-4">

                    <small class="text-muted">
                        Supplier Name
                    </small>

                    <h4 class="fw-bold mb-0">

                        @Model.Name

                    </h4>

                </div>


                <div class="mb-4">

                    <small class="text-muted">
                        Address
                    </small>

                    <p class="mb-0">

                        <i class="fas fa-location-dot text-danger me-2"></i>

                        @(string.IsNullOrWhiteSpace(Model.Address)
                                                ? "-"
                                                : Model.Address)

                    </p>

                </div>


                <div class="mb-4">

                    <small class="text-muted">
                        Phone
                    </small>

                    <p class="mb-0">

                        <i class="fas fa-phone text-success me-2"></i>

                        @(string.IsNullOrWhiteSpace(Model.Phone)
                                                ? "-"
                                                : Model.Phone)

                    </p>

                </div>


                <div>

                    <small class="text-muted">
                        Email
                    </small>

                    <p class="mb-0">

                        <i class="fas fa-envelope text-primary me-2"></i>

                        @(string.IsNullOrWhiteSpace(Model.Email)
                                                ? "-"
                                                : Model.Email)

                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- STATUS -->

    <div class="col-md-6 mb-4">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-header bg-light">

                <h5 class="mb-0">

                    <i class="fas fa-circle-info text-primary me-2"></i>

                    Supplier Status

                </h5>

            </div>


            <div class="card-body">

                <div class="mb-4">

                    <small class="text-muted">
                        Status
                    </small>

                    <div class="mt-2">

                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success fs-6">

                                <i class="fas fa-check-circle me-1"></i>

                                Active

                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6">

                                <i class="fas fa-ban me-1"></i>

                                Inactive

                            </span>
                        }

                    </div>

                </div>


                <div>

                    <small class="text-muted">
                        Supplier ID
                    </small>

                    <p class="mb-0">

                        <span class="badge bg-dark">

                            #@Model.Id

                        </span>

                    </p>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- STOCK RECEIPTS -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-primary text-white">

        <h5 class="mb-0">

            <i class="fas fa-file-invoice me-2"></i>

            Stock Receipts

        </h5>

    </div>


    <div class="card-body">

        @if (Model.StockReceipts != null &&
                Model.StockReceipts.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover table-bordered align-middle">

                    <thead class="table-dark">

                        <tr>

                            <th>
                                Receipt Code
                            </th>

                            <th>
                                Receipt Date
                            </th>

                            <th>
                                Total Amount
                            </th>

                            <th>
                                Created By
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var receipt in Model.StockReceipts
                                            .OrderByDescending(x => x.ReceiptDate))
                        {
                            <tr>

                                <td>

                                    <strong>

                                        @receipt.ReceiptCode

                                    </strong>

                                </td>


                                <td>

                                    @receipt.ReceiptDate
                                  

                                </td>


                                <td>

                                    <span class="text-danger fw-bold">

                                        @receipt.TotalAmount.ToString("N0") VNĐ
                                        
                                    </span>

                                </td>


                                <td>

                                    @receipt.CreatedBy

                                </td>


                                <td>

                                    <a asp-controller="StockReceipts"
                                       asp-action="Details"
                                       asp-route-id="@receipt.Id"
                                       class="btn btn-sm btn-primary">

                                        <i class="fas fa-circle-info"></i>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="fas fa-file-invoice fa-3x text-muted mb-3"></i>

                <h5>
                    No stock receipts
                </h5>

                <p class="text-muted mb-0">

                    This supplier has no stock receipt records.

                </p>

            </div>
        }

    </div>

</div>


