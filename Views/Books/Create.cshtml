@model LibraryManagement.Models.Book

@{
    ViewData["Title"] = "Add New Book";
}

<div class="page-card mb-4">

    <div class="d-flex justify-content-between align-items-center">

        <div>

            <div class="page-title">

                <i class="fas fa-book-medical text-success"></i>

                Add New Book

            </div>

            <div class="page-subtitle">

                Create a new book and upload its cover image.

            </div>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="fas fa-arrow-left"></i>

            Back

        </a>

    </div>

</div>

<div class="card shadow-lg border-0">

    <div class="card-header bg-success text-white">

        <h5 class="mb-0">

            <i class="fas fa-book"></i>

            Book Information

        </h5>

    </div>

    <div class="card-body">

        <form asp-action="Create"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <div class="row">


                <div class="col-lg-8">

                    <div class="row">

                        <div class="col-md-8 mb-3">

                            <label asp-for="Title" class="form-label fw-semibold"></label>

                            <input asp-for="Title"
                                   class="form-control form-control-lg"
                                   placeholder="Enter book title..." />

                            <span asp-validation-for="Title"
                                  class="text-danger"></span>

                        </div>

                        <div class="col-md-4 mb-3">

                            <label asp-for="ISBN" class="form-label fw-semibold"></label>

                            <input asp-for="ISBN"
                                   class="form-control form-control-lg"
                                   placeholder="978..." />

                            <span asp-validation-for="ISBN"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-4 mb-3">

                            <label asp-for="Quantity" class="form-label fw-semibold"></label>

                            <input asp-for="Quantity"
                                   class="form-control form-control-lg"
                                   min="1" />

                            <span asp-validation-for="Quantity"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Description"
                               class="form-label fw-semibold"></label>

                        <textarea asp-for="Description"
                                  rows="6"
                                  class="form-control"
                                  placeholder="Enter description..."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger"></span>

                    </div>

                </div>

                <div class="col-lg-4">

                    <div class="card border-0 shadow-sm">

                        <div class="card-header bg-light">

                            <strong>

                                <i class="fas fa-image text-success"></i>

                                Book Cover

                            </strong>

                        </div>

                        <div class="card-body text-center">

                            <img id="previewImage"
                                 src="~/images/books/no-image.png"
                                 class="img-fluid rounded shadow border mb-3"
                                 style="height:280px;object-fit:cover;" />

                            <label asp-for="ImageFile"
                                   class="form-label fw-semibold"></label>

                            <input asp-for="ImageFile"
                                   type="file"
                                   class="form-control"
                                   accept="image/*" />

                            <small class="text-muted">

                                JPG, PNG, WEBP (Max 2MB)

                            </small>

                        </div>

                    </div>

                </div>

            </div>

            <hr class="my-4" />

            <div class="row">

                <div class="col-md-4 mb-3">

                    <label asp-for="CategoryId"
                           class="form-label fw-semibold">

                        <i class="fas fa-layer-group text-primary"></i>

                        Category

                    </label>

                    <select asp-for="CategoryId"
                            class="form-select form-select-lg"
                            asp-items="ViewBag.CategoryId">

                        <option value="">

                            -- Select Category --

                        </option>

                    </select>

                    <span asp-validation-for="CategoryId"
                          class="text-danger"></span>

                </div>

                <div class="col-md-4 mb-3">

                    <label asp-for="AuthorId"
                           class="form-label fw-semibold">

                        <i class="fas fa-user-edit text-success"></i>

                        Author

                    </label>

                    <select asp-for="AuthorId"
                            class="form-select form-select-lg"
                            asp-items="ViewBag.AuthorId">

                        <option value="">

                            -- Select Author --

                        </option>

                    </select>

                    <span asp-validation-for="AuthorId"
                          class="text-danger"></span>

                </div>

                <div class="col-md-4 mb-3">

                    <label asp-for="PublisherId"
                           class="form-label fw-semibold">

                        <i class="fas fa-building text-warning"></i>

                        Publisher

                    </label>

                    <select asp-for="PublisherId"
                            class="form-select form-select-lg"
                            asp-items="ViewBag.PublisherId">

                        <option value="">

                            -- Select Publisher --

                        </option>

                    </select>

                    <span asp-validation-for="PublisherId"
                          class="text-danger"></span>

                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-between align-items-center">

                <a asp-action="Index"
                   class="btn btn-outline-secondary btn-lg">

                    <i class="fas fa-arrow-left"></i>

                    Back to List

                </a>

                <button type="submit"
                        class="btn btn-success btn-lg px-5">

                    <i class="fas fa-save"></i>

                    Create Book

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <script>

        document.getElementById("ImageFile")
        .addEventListener("change", function(e){

            const file = e.target.files[0];

            if(!file) return;

            const reader = new FileReader();

            reader.onload = function(event){

                document.getElementById("previewImage").src =
                    event.target.result;

            }

            reader.readAsDataURL(file);

        });

    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
