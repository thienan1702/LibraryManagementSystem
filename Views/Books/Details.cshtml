@model LibraryManagement.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<div class="card shadow">

    <div class="card-header bg-primary text-white">

        <h3>@Model.Title</h3>

    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-4 text-center">

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         class="img-fluid rounded shadow"
                         style="max-height:350px;" />
                }
                else
                {
                    <img src="~/images/no-image.png"
                         class="img-fluid rounded shadow"
                         style="max-height:350px;" />
                }

            </div>

            <div class="card mt-4 shadow-sm">

                <div class="card-header bg-dark text-white">

                    <i class="fas fa-barcode me-2"></i>

                    Barcode

                </div>

                <div class="card-body text-center">

                    <img src="@Url.Action("Barcode", "Books", new { isbn = Model.ISBN })"
                         class="img-fluid"
                         style="max-height:100px;" />

                    <div class="mt-3">

                        <strong>@Model.ISBN</strong>

                    </div>

                    <hr />
                    <a href="@Url.Action("Barcode", "Books", new { isbn = Model.ISBN })"
                       download="@($"{Model.ISBN}.png")"
                       class="btn btn-success btn-sm">

                        <i class="fas fa-download"></i>

                        Download

                    </a>

                    <a target="_blank"
                       href="@Url.Action("PrintBarcode", "Books", new { isbn = Model.ISBN })"
                       class="btn btn-primary btn-sm">

                        <i class="fas fa-print"></i>

                        Print

                    </a>

                </div>

            </div>

            <div class="col-md-8">

                <table class="table table-hover align-middle">
                    <tr>
                    

                        <th width="180">

                            <i class="fas fa-barcode text-secondary me-2"></i>

                            ISBN

                        </th>

                        <td>@Model.ISBN</td>

                    
                    </tr>

                    <tr>

                        <th>

                            <i class="fas fa-user text-primary me-2"></i>

                            Author

                        </th>

                        <td>@Model.Author?.Name</td>

                    </tr>


                    <tr>

                        <th>

                            <i class="fas fa-tags text-success me-2"></i>

                            Category

                        </th>

                        <td>@Model.Category?.Name</td>

                    </tr>


                    <tr>

                        <th>

                            <i class="fas fa-building text-warning me-2"></i>

                            Publisher

                        </th>

                        <td>@Model.Publisher?.Name</td>

                    </tr>


                    
                        <td>

                            <span class="badge bg-primary">

                                @Model.Quantity

                            </span>

                        </td>


                    <td>

                        <span class="badge bg-success">

                            @Model.AvailableQuantity

                        </span>

                    </td>

                    <tr>

                        <th>

                            <i class="fas fa-book-reader text-danger me-2"></i>

                            Borrowed

                        </th>

                        <td>

                            <span class="badge bg-danger">

                                @(Model.Quantity - Model.AvailableQuantity)

                            </span>

                        </td>

                    </tr>


                    <tr>
                        <th>Description</th>
                        <td>@Model.Description</td>
                    </tr>

                </table>

            </div>

        </div>

    </div>

    <hr />

    <h4 class="mb-4">

        <i class="fas fa-history text-primary"></i>

        Borrow History

    </h4>
    @if (Model.BorrowDetails.Any())
    {
        <table class="table table-hover align-middle">

            <thead class="table-dark">

                <tr>

                    <th>Borrower</th>

                    <th>Borrow Date</th>

                    <th>Return Date</th>

                    <th>Status</th>

                    <th>Quantity</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var history in Model.BorrowDetails.OrderByDescending(x => x.Borrow.BorrowDate))
                {
                    <tr>

                        <td>
                            @history.Borrow.BorrowerName
                        </td>

                        <td>
                            @history.Borrow.BorrowDate.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            @(history.Borrow.ReturnDate?.ToString("dd/MM/yyyy") ?? "-")
                        </td>

                        <td>

                            @if (history.Borrow.IsReturned)
                            {
                                <span class="badge bg-success">
                                    Returned
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Borrowing
                                </span>
                            }

                        </td>

                        <td>

                            @history.Quantity

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }
    else
    {
        <div class="alert alert-info">

            This book has never been borrowed.

        </div>
    }

    <div class="card-footer text-end">

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">

            <i class="fas fa-edit"></i>

            Edit

        </a>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="fas fa-arrow-left"></i>

            Back

        </a>

    </div>

</div>