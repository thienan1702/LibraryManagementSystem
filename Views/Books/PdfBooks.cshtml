@model IEnumerable<LibraryManagement.Models.Book>

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <style>

        body {
            font-family: Arial;
            font-size: 13px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            border: 1px solid black;
            padding: 6px;
        }

        th {
            background: #efefef;
        }

    </style>

</head>

<body>

    <h2>Library Book List</h2>

    <table>

        <thead>

            <tr>

                <th>Title</th>

                <th>Author</th>

                <th>Category</th>

                <th>Publisher</th>

                <th>Quantity</th>

                <th>Available</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.Title</td>

                    <td>@item.Author?.Name</td>

                    <td>@item.Category?.Name</td>

                    <td>@item.Publisher?.Name</td>

                    <td>@item.Quantity</td>

                    <td>@item.AvailableQuantity</td>

                </tr>
            }

        </tbody>

    </table>

</body>

</html>