@model IEnumerable<LibraryManagement.Models.Author>

@{
    ViewData["Title"] = "Author Management";
}

<div class="page-card">

    <div class="d-flex justify-content-between align-items-center">

        <div>

            <div class="page-title">

                <i class="fas fa-user-edit text-primary"></i>

                Author Management

            </div>

            <div class="page-subtitle">

                Manage all authors in the library

            </div>

        </div>

        <a asp-action="Create"
           class="btn btn-app btn-add">

            <i class="fas fa-plus"></i>

            Add Author

        </a>

    </div>

</div>

<form asp-action="Index" method="get" class="mb-3">

    <div class="input-group">

        <span class="input-group-text">

            <i class="fas fa-search"></i>

        </span>

        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control"
               placeholder="Search..." />

        <button class="btn btn-primary">

            Search

        </button>

        <a asp-action="Index"
           class="btn btn-secondary">

            Reset

        </a>

    </div>

</form>


<div class="row mb-3">

    <div class="col-md-3">

        <div class="small-box bg-primary">

            <div class="inner">

                <h3>@Model.Count()</h3>

                <p>Total Authors</p>

            </div>

            <div class="icon">

                <i class="fas fa-user-edit"></i>

            </div>

        </div>

    </div>

</div>


<div class="card shadow-sm border-0 mt-3">

    <div class="card-body p-0">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-dark">

                <tr>

                    <th width="80">#</th>

                    <th>Name</th>

                    <th>Biography</th>

                    <th width="260">Action</th>

                </tr>

            </thead>

            <tbody>

                @{
                    int stt = 1;
                }

                @foreach (var item in Model)
                {
                    <tr>

                        <td>

                            <span class="badge bg-primary">

                                @stt

                            </span>

                        </td>

                        <td>

                            <div class="d-flex align-items-center">

                                <div class="avatar-circle">

                                    @item.Name.Substring(0, 1)

                                </div>

                                <div class="ms-2">

                                    <strong>@item.Name</strong>

                                </div>

                            </div>

                        </td>

                        <td>

                            @if (!string.IsNullOrEmpty(item.Biography))
                            {
                                @(item.Biography.Length > 120
                                                        ? item.Biography.Substring(0, 120) + "..."
                                                        : item.Biography)
                                                }

                        </td>

                        <td>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-app btn-edit">

                                <i class="fas fa-edit"></i>

                                Edit

                            </a>

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-app btn-detail">

                                <i class="fas fa-circle-info"></i>

                                Details

                            </a>

                            <form asp-action="Delete"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  class="d-inline delete-form">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-app btn-delete">

                                    <i class="fas fa-trash"></i>
                                    Delete

                                </button>

                            </form>

                        </td>

                    </tr>

                    stt++;
                }

            </tbody>

        </table>

    </div>

</div>
@section Scripts {

    <script>

               document.querySelectorAll(".delete-form").forEach(form => {

            form.addEventListener("submit", function (e) {

                e.preventDefault();

                Swal.fire({

                    title: "Delete Author?",

                    text: "This action cannot be undone.",

                    icon: "warning",

                    showCancelButton: true,

                    confirmButtonColor: "#dc3545",

                    cancelButtonColor: "#6c757d",

                    confirmButtonText: "Delete"

                }).then(result => {

                    if (result.isConfirmed) {

                        form.submit();

                    }

                });

            });

        });

    </script>

}