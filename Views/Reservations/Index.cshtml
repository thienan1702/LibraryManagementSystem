@using X.PagedList
@using X.PagedList.Mvc.Core

@model IPagedList<LibraryManagement.Models.Reservation>
@{
    ViewData["Title"] = "Reservations";

    var waiting = ViewBag.Waiting ?? 0;
    var approved = ViewBag.Approved ?? 0;
    var rejected = ViewBag.Rejected ?? 0;
}
<div class="container-fluid">

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body d-flex justify-content-between align-items-center">

            <div>

                <h3 class="mb-1">

                    <i class="fas fa-bookmark text-primary"></i>

                    Reservations

                </h3>

                <small class="text-muted">

                    Manage all customer reservations

                </small>

            </div>
            <a asp-action="Create"
               class="btn btn-lg shadow-sm text-white"
               style="
        background:linear-gradient(135deg,#2563eb,#3b82f6);
        border:none;
        border-radius:14px;
        font-weight:600;
        padding:10px 24px;
        transition:.25s;">

                <i class="fas fa-plus-circle me-2"></i>

                New Reservation

            </a>

            <style>
                .btn:hover {
                    transform: translateY(-2px);
                }
            </style>

        </div>

    </div>


    <div class="row mb-4">

        <div class="col-md-4">

            <div class="small-box bg-warning">

                <div class="inner">

                    <h3>@waiting</h3>

                    <p>Waiting</p>

                </div>

                <div class="icon">

                    <i class="fas fa-clock"></i>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="small-box bg-success">

                <div class="inner">

                    <h3>@approved</h3>

                    <p>Approved</p>

                </div>

                <div class="icon">

                    <i class="fas fa-check-circle"></i>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="small-box bg-danger">

                <div class="inner">

                    <h3>@rejected</h3>

                    <p>Rejected</p>

                </div>

                <div class="icon">

                    <i class="fas fa-times-circle"></i>

                </div>

            </div>

        </div>

    </div>



    <div class="card shadow-sm border-0">

        <div class="card-body p-0">

            <table class="table table-hover align-middle mb-0">

                <thead class="bg-gradient-primary text-white">
                    <tr>
                        <th width="60">#</th>

                        <th>Customer</th>

                        <th>Email</th>

                        <th>Book</th>

                        <th width="90">Qty</th>

                        <th width="120">Reservation Date</th>

                        <th width="120">Status</th>

                        <th width="220" class="text-center">

                            Action

                        </th>

                    </tr>

                </thead>

                <tbody>

                    @{
                        int stt = (Model.PageNumber - 1) * Model.PageSize + 1;
                    }

                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- STT -->
                            <td>

                                <span class="badge bg-primary">

                                    @stt

                                </span>

                            </td>


                            <!-- Customer -->
                            <td>

                                <strong>@item.CustomerName</strong>

                            </td>


                            <!-- Email -->
                            <td>

                                @item.CustomerEmail

                            </td>


                            <!-- Book -->
                            <td>

                                @item.Book?.Title

                            </td>


                            <!-- Quantity -->
                            <td>

                                <span class="badge bg-info">

                                    @item.Quantity

                                </span>

                            </td>


                            <!-- Reservation Date -->
                            <td>

                                @item.ReservationDate.ToString("dd/MM/yyyy")

                            </td>


                            <!-- Status -->
                            <td>

                                @if (item.Status == ReservationStatus.Waiting)
                                {
                                    <span class="badge bg-warning">

                                        <i class="fas fa-clock"></i>

                                        Waiting

                                    </span>
                                }
                                else if (item.Status == ReservationStatus.Approved)
                                {
                                    <span class="badge bg-success">

                                        <i class="fas fa-check"></i>

                                        Approved

                                    </span>
                                }
                                else if (item.Status == ReservationStatus.Rejected)
                                {
                                    <span class="badge bg-danger">

                                        <i class="fas fa-times"></i>

                                        Rejected

                                    </span>
                                }
                                else if (item.Status == ReservationStatus.Completed)
                                {
                                    <span class="badge bg-primary">

                                        <i class="fas fa-check-double"></i>

                                        Completed

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">

                                        <i class="fas fa-ban"></i>

                                        Cancelled

                                    </span>
                                }

                            </td>


                            <!-- Action -->
                            <td class="text-center">

                                @if (item.Status == ReservationStatus.Waiting)
                                {
                                    <a asp-action="Approve"
                                       asp-route-id="@item.Id"
                                       class="btn btn-success btn-sm"
                                       title="Approve">

                                        <i class="fas fa-check"></i>

                                    </a>

                                    <a asp-action="Reject"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm"
                                       title="Reject">

                                        <i class="fas fa-times"></i>

                                    </a>
                                }

                                @if (item.Status == ReservationStatus.Approved)
                                {
                                    <a asp-action="BorrowReserved"
                                       asp-route-id="@item.Id"
                                       class="btn btn-primary btn-sm">

                                        <i class="fas fa-book"></i>

                                        Borrow

                                    </a>
                                }

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-info btn-sm"
                                   title="Details">

                                    <i class="fas fa-eye"></i>

                                </a>

                            </td>

                        </tr>

                        stt++;
                    }


                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="8"
                                class="text-center py-5">

                                <i class="fas fa-bookmark fa-3x text-muted mb-3"></i>

                                <h5>No reservations found</h5>

                                <span class="text-muted">
                                    Customer reservations will appear here.
                                </span>

                            </td>

                        </tr>
                    }

                </tbody>
            </table>

        </div>

    </div>

</div>
<div class="d-flex justify-content-center mt-4">

    @Html.PagedListPager(

    Model,

    page => Url.Action("Index", new
    {
        page
    }),

        new PagedListRenderOptions
        {
            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
            DisplayLinkToLastPage = PagedListDisplayMode.Always,
            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
            DisplayLinkToNextPage = PagedListDisplayMode.Always,

            LinkToFirstPageFormat = "<<",
            LinkToPreviousPageFormat = "Previous",
            LinkToNextPageFormat = "Next",
            LinkToLastPageFormat = ">>",

            MaximumPageNumbersToDisplay = 5,

            UlElementClasses = new[] { "pagination" },

            LiElementClasses = new[] { "page-item" },

            PageClasses = new[] { "page-link" }
        })

</div>