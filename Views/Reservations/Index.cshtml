@model IEnumerable<LibraryManagement.Models.Reservation>

@{
    ViewData["Title"] = "Reservations";

    var waiting = Model.Count(x => x.Status == ReservationStatus.Waiting);
    var approved = Model.Count(x => x.Status == ReservationStatus.Approved);
    var rejected = Model.Count(x => x.Status == ReservationStatus.Rejected);
}
<div class="container-fluid">

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body d-flex justify-content-between align-items-center">

            <div>

                <h3 class="mb-1">

                    <i class="fas fa-bookmark text-primary"></i>

                    Reservations

                </h3>

                <small class="text-muted">

                    Manage all customer reservations

                </small>

            </div>
            <a asp-action="Create"
               class="btn btn-lg shadow-sm text-white"
               style="
        background:linear-gradient(135deg,#2563eb,#3b82f6);
        border:none;
        border-radius:14px;
        font-weight:600;
        padding:10px 24px;
        transition:.25s;">

                <i class="fas fa-plus-circle me-2"></i>

                New Reservation

            </a>

            <style>
                .btn:hover {
                    transform: translateY(-2px);
                }
            </style>

        </div>

    </div>


    <div class="row mb-4">

        <div class="col-md-4">

            <div class="small-box bg-warning">

                <div class="inner">

                    <h3>@waiting</h3>

                    <p>Waiting</p>

                </div>

                <div class="icon">

                    <i class="fas fa-clock"></i>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="small-box bg-success">

                <div class="inner">

                    <h3>@approved</h3>

                    <p>Approved</p>

                </div>

                <div class="icon">

                    <i class="fas fa-check-circle"></i>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="small-box bg-danger">

                <div class="inner">

                    <h3>@rejected</h3>

                    <p>Rejected</p>

                </div>

                <div class="icon">

                    <i class="fas fa-times-circle"></i>

                </div>

            </div>

        </div>

    </div>



    <div class="card shadow-sm border-0">

        <div class="card-body p-0">

            <table class="table table-hover align-middle mb-0">

                <thead class="bg-gradient-primary text-white">
                    <tr>

                        <th>Customer</th>

                        <th>Email</th>

                        <th>Book</th>

                        <th width="90">Qty</th>

                        <th width="120">Reservation Date</th>

                        <th width="120">Status</th>

                        <th width="220" class="text-center">

                            Action

                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>

                                <strong>@item.CustomerName</strong>

                            </td>

                            <td>

                                @item.CustomerEmail

                            </td>

                            <td>

                                @item.Book?.Title

                            </td>

                            <td>

                                <span class="badge bg-info">

                                    @item.Quantity

                                </span>

                            </td>

                            <td>

                                @item.ReservationDate.ToString("dd/MM/yyyy")

                            </td>

                            <td>

                                @if (item.Status == ReservationStatus.Waiting)
                                {
                                    <span class="badge bg-warning">

                                        <i class="fas fa-clock"></i>

                                        Waiting

                                    </span>
                                }
                                else if (item.Status == ReservationStatus.Approved)
                                {
                                    <span class="badge bg-success">

                                        <i class="fas fa-check"></i>

                                        Approved

                                    </span>
                                }
                                else if (item.Status == ReservationStatus.Rejected)
                                {
                                    <span class="badge bg-danger">

                                        <i class="fas fa-times"></i>

                                        Rejected

                                    </span>
                                }

                                else if (item.Status == ReservationStatus.Completed)
                                {
                                    <span class="badge bg-primary">

                                        <i class="fas fa-times"></i>

                                        Completed

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">

                                        Cancelled

                                    </span>
                                }

                            </td>

                            <td class="text-center">

                                @if (item.Status == ReservationStatus.Waiting)
                                {
                                    <a asp-action="Approve"
                                       asp-route-id="@item.Id"
                                       class="btn btn-success btn-sm">

                                        <i class="fas fa-check"></i>

                                    </a>

                                    <a asp-action="Reject"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm">

                                        <i class="fas fa-times"></i>

                                    </a>

                                }

                                @if (item.Status == ReservationStatus.Approved)
                                {
                                    <a asp-action="BorrowReserved"
                                       asp-route-id="@item.Id"
                                       class="btn btn-primary btn-sm">

                                        <i class="fas fa-book"></i>

                                        Borrow

                                    </a>
                                }

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-info btn-sm">

                                    <i class="fas fa-eye"></i>

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>