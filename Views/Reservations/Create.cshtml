@model LibraryManagement.Models.Reservation

@{
    ViewData["Title"] = "Reserve Book";
    var books = ViewBag.Books as List<LibraryManagement.Models.Book>;
}

<div class="card">
    <div class="card-header">
        <h3>Reserve Book</h3>
    </div>

    <div class="card-body">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label>Name</label>
                <input asp-for="CustomerName" class="form-control" />
            </div>

            <div class="mb-3">
                <label>Email</label>
                <input asp-for="CustomerEmail" class="form-control" />
            </div>

            <div class="mb-3">
                <label>Book</label>

                <select asp-for="BookId" class="form-select">
                    @foreach (var b in books)
                    {
                        <option value="@b.Id">@b.Title</option>
                    }
                </select>

            </div>

            <button class="btn btn-primary">
                Reserve
            </button>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}