@model LibraryManagement.Models.Category

@{
    ViewData["Title"] = "Category Details";
}

<div class="page-card">

    <div class="d-flex justify-content-between align-items-center">

        <div>

            <div class="page-title">

                <i class="fas fa-tags text-primary"></i>

                Category Details

            </div>

            <div class="page-subtitle">

                View category information

            </div>

        </div>

        <div>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-app btn-edit">

                <i class="fas fa-edit"></i>

                Edit

            </a>

            <a asp-action="Index"
               class="btn btn-app btn-detail">

                <i class="fas fa-arrow-left"></i>

                Back

            </a>

        </div>

    </div>

</div>


<div class="card shadow-sm border-0 mt-3">

    <div class="card-body">

        <div class="text-center mb-4">

            <div class="avatar-circle mx-auto"
                 style="width:90px;height:90px;font-size:34px;">

                @Model.Name.Substring(0, 1).ToUpper()

            </div>

            <h3 class="mt-3 mb-0">

                @Model.Name

            </h3>

            <span class="badge bg-primary mt-2">

                Category #@Model.Id

            </span>

        </div>

        <hr />

        <div class="row">

            <div class="col-md-3">

                <strong>

                    <i class="fas fa-tag text-primary"></i>

                    Name

                </strong>

            </div>

            <div class="col-md-9">

                @Model.Name

            </div>

        </div>

        <hr />

        <div class="row">

            <div class="col-md-3">

                <strong>

                    <i class="fas fa-align-left text-success"></i>

                    Description

                </strong>

            </div>

            <div class="col-md-9">

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    @Model.Description
                }
                else
                {
                    <span class="text-muted fst-italic">

                        No description available.

                    </span>
                }

            </div>

        </div>

    </div>

</div>