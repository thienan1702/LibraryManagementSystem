@model LibraryManagement.Models.Category

@{
    ViewData["Title"] = "Add Category";
}

<div class="container-fluid py-4">

    ```
    <!-- Header -->

    <div class="page-card mb-4">

        <div class="d-flex justify-content-between align-items-center">

            <div>

                <div class="page-title">

                    <i class="fas fa-layer-group text-primary"></i>

                    Add Category

                </div>

                <div class="page-subtitle">

                    Create a new book category for the library

                </div>

            </div>

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="fas fa-arrow-left me-1"></i>

                Back to Categories

            </a>

        </div>

    </div>


    <!-- Form -->

    <div class="row justify-content-center">

        <div class="col-lg-8 col-xl-7">

            <div class="card shadow-sm border-0">

                <!-- Card Header -->

                <div class="card-header bg-primary text-white py-3">

                    <div class="d-flex align-items-center">

                        <div class="me-3">

                            <i class="fas fa-folder-plus fa-lg"></i>

                        </div>

                        <div>

                            <h5 class="mb-0">

                                Category Information

                            </h5>

                            <small class="opacity-75">

                                Enter the information for the new category

                            </small>

                        </div>

                    </div>

                </div>


                <!-- Card Body -->

                <div class="card-body p-4">

                    <form asp-action="Create">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>


                        <!-- Category Name -->

                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">

                                <i class="fas fa-tag text-primary me-1"></i>

                                Category Name

                                <span class="text-danger">*</span>

                            </label>

                            <input asp-for="Name"
                                   class="form-control form-control-lg"
                                   placeholder="Enter category name..."
                                   autocomplete="off" />

                            <div class="form-text">

                                Example: Fiction, Science, Technology, History...

                            </div>

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Description -->

                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label fw-semibold">

                                <i class="fas fa-align-left text-primary me-1"></i>

                                Description

                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Enter a short description for this category..."></textarea>

                            <div class="form-text">

                                Provide a brief description to help identify this category.

                            </div>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Preview -->

                        <div class="alert alert-light border mb-4">

                            <div class="d-flex align-items-center">

                                <div class="me-3">

                                    <div class="rounded-circle bg-primary text-white
                                            d-flex align-items-center justify-content-center"
                                         style="width:50px;height:50px;">

                                        <i class="fas fa-layer-group"></i>

                                    </div>

                                </div>

                                <div>

                                    <div class="fw-semibold">

                                        New Library Category

                                    </div>

                                    <small class="text-muted">

                                        The category will be available when adding or editing books.

                                    </small>

                                </div>

                            </div>

                        </div>


                        <!-- Buttons -->

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">

                                <i class="fas fa-xmark me-1"></i>

                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4">

                                <i class="fas fa-plus me-1"></i>

                                Add Category

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>
    ```

</div>

@section Scripts {

    ```
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
    ```

}
