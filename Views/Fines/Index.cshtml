@model IEnumerable<LibraryManagement.Models.Borrow>

@{
    ViewData["Title"] = "Fine Management";
}

<h2 class="mb-4">
    Fine Management
</h2>

<table class="table table-bordered table-hover">

    <thead class="table-dark">

        <tr>

            <th>Borrower</th>

            <th>Borrow Date</th>

            <th>Due Date</th>

            <th>Fine</th>

            <th>Status</th>

            <th width="120"></th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.BorrowerName</td>

                <td>@item.BorrowDate.ToString("dd/MM/yyyy")</td>

                <td>@item.DueDate.ToString("dd/MM/yyyy")</td>

                <td class="text-danger fw-bold">
                    @item.FineAmount.ToString("N0") đ
                </td>

                <td>

                    @if (item.IsPaid)
                    {
                        <span class="badge bg-success">
                            Paid
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Unpaid
                        </span>
                    }

                </td>

                <td>

                    @if (!item.IsPaid)
                    {
                        <a asp-action="Pay"
                           asp-route-id="@item.Id"
                           class="btn btn-success btn-sm">

                            Pay

                        </a>
                    }

                </td>

            </tr>
        }

    </tbody>

</table>