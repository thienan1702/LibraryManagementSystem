@model IEnumerable<LibraryManagement.Models.ViewModels.TopBookViewModel>

@{
    ViewData["Title"] = "Top Borrowed Books Report";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>
            <i class="fas fa-fire text-danger"></i>
            Top Borrowed Books Report
        </h2>

        <div>


            <a asp-action="ExportTopBooksExcel"
               class="btn btn-success export-btn">

                <i class="fas fa-file-excel"></i>
                Export Excel

            </a>

            <a asp-action="ExportTopBooksPdf"
               class="btn btn-danger export-btn">

                <i class="fas fa-file-pdf"></i>
                Export PDF

            </a>

           
        </div>

    </div>

    <!-- Summary -->

    <div class="row mb-4">

        <div class="col-md-4">

            <div class="card shadow border-0">

                <div class="card-body">

                    <h6 class="text-muted">
                        Total Books
                    </h6>

                    <h3 class="fw-bold">

                        @Model.Count()

                    </h3>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow border-0">

                <div class="card-body">

                    <h6 class="text-muted">
                        Total Borrow
                    </h6>

                    <h3 class="fw-bold text-primary">

                        @Model.Sum(x => x.BorrowCount)

                    </h3>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow border-0">

                <div class="card-body">

                    <h6 class="text-muted">
                        Most Borrowed
                    </h6>

                    <h5 class="fw-bold text-success">

                        @(Model.FirstOrDefault()?.BookTitle ?? "-")

                    </h5>

                </div>

            </div>

        </div>

    </div>

    <!-- Table -->

    <div class="card shadow">

        <div class="card-body">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">

                    <tr>

                        <th width="70">Rank</th>

                        <th>Book</th>

                        <th>Author</th>

                        <th>Category</th>

                        <th width="150">Borrow Count</th>

                    </tr>

                </thead>

                <tbody>

                    @{
                        int rank = 1;
                    }

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td class="text-center">

                                @rank

                            </td>

                            <td>

                                @item.BookTitle

                            </td>

                            <td>

                                @item.Author

                            </td>

                            <td>

                                @item.Category

                            </td>

                            <td class="text-center">

                                <span class="badge bg-primary">

                                    @item.BorrowCount

                                </span>

                            </td>

                        </tr>

                        rank++;
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>