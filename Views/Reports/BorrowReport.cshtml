@model LibraryManagement.ViewModels.BorrowReportVM

@{
    ViewData["Title"] = "Borrow Report";
}

<div class="container-fluid">

    <div class="card shadow border-0">

        <div class="card-header bg-primary text-white">

            <h4 class="mb-0">
                <i class="fas fa-chart-bar"></i>
                Borrow Report
            </h4>

       

        </div>

        <div class="card-body">

            <form asp-action="BorrowReport" method="get">

                <div class="row">

                    <div class="col-md-3">

                        <label>From Date</label>

                        <input asp-for="FromDate"
                               class="form-control"
                               type="date" />

                    </div>

                    <div class="col-md-3">

                        <label>To Date</label>

                        <input asp-for="ToDate"
                               class="form-control"
                               type="date" />

                    </div>

                    <div class="col-md-4">

                        <label>Borrower / Email</label>

                        <input asp-for="Keyword"
                               class="form-control"
                               placeholder="Search..." />

                    </div>

                    <div class="col-md-2 d-flex align-items-end">

                        <button class="btn btn-primary me-2 w-100">

                            <i class="fas fa-search"></i>

                            Search

                        </button>

                    </div>

                </div>

            </form>

            <hr />

            <div class="mb-3">

                <a asp-action="BorrowReport"
                   class="btn btn-secondary">

                    <i class="fas fa-rotate-left"></i>

                    Reset

                </a>

                <a asp-action="ExportExcel"
                   id="btnExcel"
                   class="btn btn-success export-btn">

                    <i class="fas fa-file-excel"></i>
                    Export Excel

                </a>

                <a asp-action="ExportPdf"
                   id="btnPdf"
                   class="btn btn-danger export-btn">

                    <i class="fas fa-file-pdf"></i>
                    Export PDF

                </a>

                <a asp-action="Index"
                   class="btn btn-primary btn-sm border border-white">

                    <i class="fas fa-arrow-left me-1"></i>
                    Back

                </a>

            </div>

            <div class="table-responsive">
                @if (Model.Borrows.Any())
{
                <table class="table table-hover table-bordered align-middle">

                    <thead class="table-dark">

                        <tr>

                            <th>#</th>

                            <th>Borrower</th>

                            <th>Email</th>

                            <th>Borrow Date</th>

                            <th>Due Date</th>

                            <th>Status</th>

                            <th>Fine</th>

                        </tr>

                    </thead>

                    <tbody>

                        @{
                            int stt = 1;
                        }

                        @foreach (var item in Model.Borrows)
                        {
                            <tr>

                                <td>@stt</td>

                                <td>

                                    <strong>@item.BorrowerName</strong>

                                </td>

                                <td>@item.BorrowerEmail</td>

                                <td>

                                    @item.BorrowDate.ToString("dd/MM/yyyy")

                                </td>

                                <td>

                                    @item.DueDate.ToString("dd/MM/yyyy")

                                </td>

                                <td>

                                    @if (!item.IsReturned)
                                    {
                                        if (item.DueDate < DateTime.Today)
                                        {
                                            <span class="badge bg-danger">
                                                Overdue
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Borrowing
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Returned
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (item.FineAmount > 0)
                                    {
                                        <span class="text-danger fw-bold">

                                            @item.FineAmount.ToString("N0") đ

                                        </span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }

                                </td>

                            </tr>

                            stt++;
                        }

                    </tbody>

                </table>

                }
                else
                {
                    <partial name="_EmptyState" />
                }

            </div>

        </div>

    </div>

</div>