@model IEnumerable<LibraryManagement.Models.Reservation>

@{
    ViewData["Title"] = "Reservation Report";

    var total = Model.Count();

    var waiting = Model.Count(x => x.Status == LibraryManagement.Models.ReservationStatus.Waiting);

    var approved = Model.Count(x => x.Status == LibraryManagement.Models.ReservationStatus.Approved);

    var completed = Model.Count(x => x.Status == LibraryManagement.Models.ReservationStatus.Completed);

    var cancelled = Model.Count(x => x.Status == LibraryManagement.Models.ReservationStatus.Cancelled);
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                Reservation Report
            </h2>

            <p class="text-muted mb-0">
                Reservation statistics
            </p>
        </div>

        <div>

            <a asp-action="ExportReservationExcel"
               class="btn btn-success  export-btn">

                <i class="bi bi-file-earmark-excel"></i>

                Export Excel

            </a>

            <a asp-action="ExportReservationPdf"
               class="btn btn-danger export-btn">

                <i class="bi bi-file-earmark-pdf"></i>

                Export PDF

            </a>        

        </div>

    </div>

    <div class="row mb-4">

        <div class="col-md-3">

            <div class="card border-primary shadow-sm">

                <div class="card-body">

                    <h6>Total Reservations</h6>

                    <h2 class="fw-bold text-primary">
                        @total
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card border-warning shadow-sm">

                <div class="card-body">

                    <h6>Waiting</h6>

                    <h2 class="fw-bold text-warning">
                        @waiting
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card border-success shadow-sm">

                <div class="card-body">

                    <h6>Completed</h6>

                    <h2 class="fw-bold text-success">
                        @completed
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card border-danger shadow-sm">

                <div class="card-body">

                    <h6>Cancelled</h6>

                    <h2 class="fw-bold text-danger">
                        @cancelled
                    </h2>

                </div>

            </div>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-dark text-white">

            Reservation List

        </div>

        <div class="card-body">



            <div class="table-responsive">


                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-dark">

                        <tr>

                            <th>No</th>

                            <th>Customer</th>

                            <th>Email</th>

                            <th>Book</th>

                            <th>Quantity</th>

                            <th>Reservation Date</th>

                            <th>Status</th>

                        </tr>

                    </thead>

                    <tbody>

                        @{
                            int stt = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@stt</td>

                                <td>@item.CustomerName</td>

                                <td>@item.CustomerEmail</td>

                                <td>@item.Book?.Title</td>

                                <td class="text-center">
                                    @item.Quantity
                                </td>

                                <td>
                                    @item.ReservationDate.ToString("dd/MM/yyyy")
                                </td>

                                <td>

                                    @switch (item.Status)
                                    {
                                        case LibraryManagement.Models.ReservationStatus.Waiting:

                                            <span class="badge bg-warning">
                                                Waiting
                                            </span>

                                            break;

                                        case LibraryManagement.Models.ReservationStatus.Approved:

                                            <span class="badge bg-primary">
                                                Approved
                                            </span>

                                            break;

                                        case LibraryManagement.Models.ReservationStatus.Completed:

                                            <span class="badge bg-success">
                                                Completed
                                            </span>

                                            break;

                                        case LibraryManagement.Models.ReservationStatus.Rejected:

                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>

                                            break;

                                        case LibraryManagement.Models.ReservationStatus.Cancelled:

                                            <span class="badge bg-secondary">
                                                Cancelled
                                            </span>

                                            break;
                                    }

                                </td>

                            </tr>

                            stt++;
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>