@model LibraryManagement.ViewModels.InventoryReportVM

@{
    ViewData["Title"] = "Inventory Report";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-primary mb-1">
                Inventory Report
            </h2>

            <small class="text-muted">
                Library inventory statistics
            </small>
        </div>

        <div>
            <a asp-action="ExportInventoryExcel"
               asp-route-keyword="@Model.Keyword"
               class="btn btn-success export-btn">

                <i class="bi bi-file-earmark-excel"></i>
                Export Excel

            </a>
            <a asp-action="ExportInventoryPdf"
               asp-route-keyword="@Model.Keyword"
               class="btn btn-danger export-btn">

                <i class="bi bi-file-earmark-pdf"></i>
                Export PDF

            </a>

           
        </div>

    </div>

    <!-- Search -->

    <form method="get" class="row mb-4">

        <div class="col-md-5">

            <input class="form-control"
                   name="keyword"
                   value="@Model.Keyword"
                   placeholder="Search title, author..." />

        </div>

        <div class="col-auto">

            <button class="btn btn-primary">

                Search

            </button>

        </div>

    </form>

    <!-- Summary -->

    <div class="row g-3 mb-4">

        <div class="col-md-2">

            <div class="card shadow-sm border-primary">

                <div class="card-body text-center">

                    <h6>Total Titles</h6>

                    <h3>@Model.TotalTitles</h3>

                </div>

            </div>

        </div>

        <div class="col-md-2">

            <div class="card shadow-sm border-success">

                <div class="card-body text-center">

                    <h6>Total Books</h6>

                    <h3>@Model.TotalBooks</h3>

                </div>

            </div>

        </div>

        <div class="col-md-2">

            <div class="card shadow-sm border-info">

                <div class="card-body text-center">

                    <h6>Available</h6>

                    <h3>@Model.AvailableBooks</h3>

                </div>

            </div>

        </div>

        <div class="col-md-2">

            <div class="card shadow-sm border-warning">

                <div class="card-body text-center">

                    <h6>Borrowed</h6>

                    <h3>@Model.BorrowedBooks</h3>

                </div>

            </div>

        </div>

        <div class="col-md-2">

            <div class="card shadow-sm border-danger">

                <div class="card-body text-center">

                    <h6>Low Stock</h6>

                    <h3>@Model.LowStock</h3>

                </div>

            </div>

        </div>

        <div class="col-md-2">

            <div class="card shadow-sm border-dark">

                <div class="card-body text-center">

                    <h6>Out Of Stock</h6>

                    <h3>@Model.OutOfStock</h3>

                </div>

            </div>

        </div>

    </div>

    <!-- Table -->

    <div class="card shadow">

        <div class="card-body">
            @if (Model.Books.Any())
{
            <table class="table table-hover align-middle">

                <thead class="table-primary">

                    <tr>

                        <th>#</th>

                        <th>Title</th>

                        <th>Author</th>

                        <th>Category</th>

                        <th>Total</th>

                        <th>Available</th>

                        <th>Status</th>

                    </tr>

                </thead>

                <tbody>

                    @{

                        int stt = 1;

                    }

                    @foreach (var book in Model.Books)

                    {
                        string badge;

                        string color;

                        if (book.AvailableQuantity == 0)
                        {
                            badge = "Out of Stock";
                            color = "danger";
                        }
                        else if (book.AvailableQuantity <= 3)
                        {
                            badge = "Low Stock";
                            color = "warning";
                        }
                        else
                        {
                            badge = "Available";
                            color = "success";
                        }

                        <tr>

                            <td>@stt</td>

                            <td>@book.Title</td>

                            <td>@book.Author.Name</td>

                            <td>@book.Category.Name</td>

                            <td>@book.Quantity</td>

                            <td>@book.AvailableQuantity</td>

                            <td>

                                <span class="badge bg-@color">

                                    @badge

                                </span>

                            </td>

                        </tr>

                        stt++;
                    }

                </tbody>

            </table>
            }
            else
            {
                <partial name="_EmptyState" />
            }
        </div>

    </div>

</div>