@using Microsoft.AspNetCore.Identity
@using LibraryManagement.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - Library Management</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- FontAwesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <!-- AdminLTE -->
    <link rel="stylesheet"
          href="~/lib/admin-lte/css/adminlte.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />


    <link rel="stylesheet" href="~/css/darkmode.css" />


</head>



<body class="hold-transition sidebar-mini">

   

    <div class="wrapper">

        <!-- Navbar -->



        <nav class="main-header navbar navbar-expand navbar-white navbar-light">

            <ul class="navbar-nav">

                <li class="nav-item">

                    <a class="nav-link"
                       data-widget="pushmenu"
                       href="#">

                        <i class="fas fa-bars"></i>

                    </a>

                </li>

                <li class="nav-item dropdown">

                    <a class="nav-link"
                       href="#"
                       data-bs-toggle="dropdown">

                        <i class="far fa-bell fa-lg"></i>

                        <span id="notifyCount"
                              class="badge bg-danger navbar-badge">

                            0

                        </span>

                    </a>

                    <div id="notifyMenu"
                         class="dropdown-menu dropdown-menu-end notification-menu">

                        Loading...

                    </div>

                </li>
            </ul>


            <li class="nav-item ms-3">

                <button id="themeToggle"
                        class="theme-btn"
                        title="Dark Mode">

                    <i id="themeIcon" class="fas fa-moon"></i>

                </button>

            </li>

            <ul class="navbar-nav ms-auto">

                <partial name="_LoginPartial" />

            </ul>

        </nav>

        <!-- Sidebar -->

        <aside class="main-sidebar sidebar-dark-primary elevation-4">

            <a asp-controller="Home"
               asp-action="Index"
               class="brand-link">

                <span class="brand-text fw-bold">

                    📚 Library Management

                </span>

            </a>

            <div class="sidebar">

                <nav class="mt-2">

                    <ul class="nav nav-pills nav-sidebar flex-column"
                        data-widget="treeview"
                        role="menu">

                        <li class="nav-item">
                            <a asp-controller="Home"
                               asp-action="Index"
                               class="nav-link">
                                <i class="nav-icon fas fa-house"></i>
                                <p>Home</p>
                            </a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a asp-controller="Dashboard"
                                   asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")">                                    
                                   <i class="nav-icon fas fa-chart-line"></i>
                                    <p>Dashboard</p>
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin") || User.IsInRole("User"))
                        {
                            <li class="nav-header">
                                LIBRARY
                            </li>


                            <li class="nav-item">

                                <a asp-controller="Reports"
                                   asp-action="Index"
                                   class="nav-link">

                                    <i class="nav-icon fas fa-chart-bar"></i>

                                    <p>Reports</p>

                                </a>

                            </li>

                            <li class="nav-item">
                                <a asp-controller="Books"
                                   asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Books" ? "active" : "")">
                                    <i class="nav-icon fas fa-book"></i>
                                    <p>Books</p>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Borrows"
                                   asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Borrows" ? "active" : "")">                                   
                                   <i class="nav-icon fas fa-handshake"></i>
                                    <p>Borrow</p>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Categories"
                                   asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Categories" ? "active" : "")">                                    
                                        <i class="nav-icon fas fa-list"></i>
                                    <p>Categories</p>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Authors"
                                   asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Authors" ? "active" : "")">                                 
                                        <i class="nav-icon fas fa-user"></i>
                                    <p>Authors</p>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Publishers"
                                   asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Publishers" ? "active" : "")">                                    
                                        <i class="nav-icon fas fa-building"></i>
                                    <p>Publishers</p>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Borrows"
                                   asp-action="FineManagement"
                                   class="nav-link">

                                    <i class="nav-icon fas fa-money-bill-wave text-danger"></i>

                                    <p>Fine Management</p>

                                </a>
                            </li>

                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-header">
                                ADMIN
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Users"
                                   asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Users" ? "active" : "")">                                   
                                   <i class="nav-icon fas fa-users"></i>
                                    <p>Users</p>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="AuditLogs"
                                   asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AuditLogs" ? "active" : "")">                                    
                                   <i class="nav-icon fas fa-clock-rotate-left"></i>
                                    <p>Audit Logs</p>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Reservations"
                                   asp-action="Index"
                                   class="nav-link">

                                    <i class="fas fa-clock"></i>

                                    <p>Reservations</p>

                                </a>
                            </li>
                        }

                    </ul>

                </nav>

            </div>

        </aside>

        <!-- Content -->

        <div class="content-wrapper">

            <section class="content pt-3">

                <div class="container-fluid">

                    @RenderBody()

                </div>

            </section>

        </div>

        <!-- Footer -->

        <footer class="main-footer">

            <strong>

                © 2026 Library Management System

            </strong>

            <div class="float-end">

                ASP.NET Core MVC

            </div>

        </footer>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/lib/admin-lte/js/adminlte.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: '@Html.Raw(TempData["Success"])',
                timer: 2200,
                showConfirmButton: false
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: '@Html.Raw(TempData["Error"])'
            });
        </script>
    }

    @if (TempData["Warning"] != null)
    {
        <script>
            Swal.fire({
                icon: 'warning',
                title: 'Warning',
                text: '@Html.Raw(TempData["Warning"])'
            });
        </script>
    }

    @if (TempData["Info"] != null)
    {
        <script>
            Swal.fire({
                icon: 'info',
                title: 'Information',
                text: '@Html.Raw(TempData["Info"])'
            });
        </script>
    }

    <script>

        let lastCount = 0;

        function loadNotification(){

            $.get("/Notifications/GetReservationNotification",function(res){

                $("#notifyCount").text(res.total);

                let html="";

                html+=`
                    <div class="dropdown-header">
                        Notifications
                    </div>
                `;

                if(res.total==0){

                    html+=`
                        <div class="dropdown-item text-center">

                            No notification

                        </div>
                    `;

                }
                else{

                    res.items.forEach(function(i){

                        html+=`

                        <a
                            class="dropdown-item"
                            href="/Reservations">

                            <div>

                                <b>${i.customerName}</b>

                            </div>

                            <small>

                                Reserved
                                ${i.book}

                            </small>

                        </a>

                        <div class="dropdown-divider"></div>

                        `;

                    });

                }

                html+=`

                <a
                    href="/Reservations"
                    class="dropdown-item text-center">

                    View All

                </a>

                `;

                $("#notifyMenu").html(html);

                if(res.total>lastCount){

                    Swal.fire({

                        toast:true,

                        position:'top-end',

                        icon:'info',

                        title:'New Reservation',

                        timer:2000,

                        showConfirmButton:false

                    });

                    animateBell();

                }

                lastCount=res.total;

            });

        }

        loadNotification();

        setInterval(loadNotification,10000);

    </script>

    <script>
        

        function showLoading() {

            document.getElementById("loading-overlay").style.display = "flex";

            setTimeout(function () {

                hideLoading();

            }, 2000);

        }

        function hideLoading() {

            document.getElementById("loading-overlay").style.display = "none";

        }

        document.addEventListener("DOMContentLoaded", function () {

            document.querySelectorAll(".export-btn")
                .forEach(function (btn) {

                    btn.addEventListener("click", function () {

                        showLoading();

                    });

                });

        });

    </script>




    <script>
        const btn = document.getElementById("themeToggle");
        const icon = document.getElementById("themeIcon");

               function updateThemeIcon() {

            if (document.body.classList.contains("dark-mode")) {

                icon.className = "fas fa-sun";

            } else {

                icon.className = "fas fa-moon";

            }

        }

        if (btn && icon) {

            if (localStorage.getItem("theme") === "dark") {

                document.body.classList.add("dark-mode");

            }

            updateThemeIcon();

            btn.addEventListener("click", function () {

                document.body.classList.toggle("dark-mode");

                localStorage.setItem(
                    "theme",
                    document.body.classList.contains("dark-mode")
                        ? "dark"
                        : "light"
                );

                updateThemeIcon();

            });

        }

                function getSwalTheme() {

            return document.body.classList.contains("dark-mode")
                ? "dark"
                : "light";

        }

        function showSuccess(title, text) {

            Swal.fire({

                icon: "success",

                title: title,

                text: text,

                confirmButtonColor: "#0d6efd",

                background: getSwalTheme() == "dark"
                    ? "#1f1f1f"
                    : "#ffffff",

                color: getSwalTheme() == "dark"
                    ? "#ffffff"
                    : "#212529"

            });

        }

        function showError(title, text) {

            Swal.fire({

                icon: "error",

                title: title,

                text: text,

                confirmButtonColor: "#dc3545",

                background: getSwalTheme() == "dark"
                    ? "#1f1f1f"
                    : "#ffffff",

                color: getSwalTheme() == "dark"
                    ? "#ffffff"
                    : "#212529"

            });

        }

        function showWarning(title, text) {

            Swal.fire({

                icon: "warning",

                title: title,

                text: text,

                confirmButtonColor: "#f59f00",

                background: getSwalTheme() == "dark"
                    ? "#1f1f1f"
                    : "#ffffff",

                color: getSwalTheme() == "dark"
                    ? "#ffffff"
                    : "#212529"

            });

        }

    </script>


    <script src="https://unpkg.com/html5-qrcode"></script>


    @await RenderSectionAsync("Scripts", required: false)

</body>


<div id="loading-overlay">

    <div class="loading-card">

        <div class="loading-book">

            <i class="fas fa-book-open"></i>

        </div>

        <h4 class="mt-4 fw-bold">
            Generating Report...
        </h4>

        <p class="text-muted mb-3">
            Please wait a moment
        </p>

        <div class="progress">

            <div class="progress-bar progress-bar-striped
                        progress-bar-animated bg-primary"
                 style="width:100%">
            </div>

        </div>

    </div>

</div>





</html>