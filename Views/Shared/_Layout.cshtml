@using Microsoft.AspNetCore.Identity
@using LibraryManagement.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - Library Management</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- FontAwesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <!-- AdminLTE -->
    <link rel="stylesheet"
          href="~/lib/admin-lte/css/adminlte.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />

</head>

<body class="hold-transition sidebar-mini">

    <div class="wrapper">

        <!-- Navbar -->

        <nav class="main-header navbar navbar-expand navbar-white navbar-light">

            <ul class="navbar-nav">

                <li class="nav-item">

                    <a class="nav-link"
                       data-widget="pushmenu"
                       href="#">

                        <i class="fas fa-bars"></i>

                    </a>

                </li>

            </ul>

            <ul class="navbar-nav ms-auto">

                <partial name="_LoginPartial" />

            </ul>

        </nav>

        <!-- Sidebar -->

        <aside class="main-sidebar sidebar-dark-primary elevation-4">

            <a asp-controller="Home"
               asp-action="Index"
               class="brand-link">

                <span class="brand-text fw-bold">

                    📚 Library Management

                </span>

            </a>

            <div class="sidebar">

                <nav class="mt-2">

                    <ul class="nav nav-pills nav-sidebar flex-column"
                        data-widget="treeview"
                        role="menu">

                        <li class="nav-item">
                            <a asp-controller="Home"
                               asp-action="Index"
                               class="nav-link">
                                <i class="nav-icon fas fa-house"></i>
                                <p>Home</p>
                            </a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a asp-controller="Dashboard"
                                   asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")">                                    
                                   <i class="nav-icon fas fa-chart-line"></i>
                                    <p>Dashboard</p>
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin") || User.IsInRole("User"))
                        {
                            <li class="nav-header">
                                LIBRARY
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Books"
                                   asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Books" ? "active" : "")">
                                    <i class="nav-icon fas fa-book"></i>
                                    <p>Books</p>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Borrows"
                                   asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Borrows" ? "active" : "")">                                   
                                   <i class="nav-icon fas fa-handshake"></i>
                                    <p>Borrow</p>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Categories"
                                   asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Categories" ? "active" : "")">                                    
                                        <i class="nav-icon fas fa-list"></i>
                                    <p>Categories</p>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Authors"
                                   asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Authors" ? "active" : "")">                                 
                                        <i class="nav-icon fas fa-user"></i>
                                    <p>Authors</p>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Publishers"
                                   asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Publishers" ? "active" : "")">                                    
                                        <i class="nav-icon fas fa-building"></i>
                                    <p>Publishers</p>
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-header">
                                ADMIN
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Users"
                                   asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Users" ? "active" : "")">                                   
                                   <i class="nav-icon fas fa-users"></i>
                                    <p>Users</p>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="AuditLogs"
                                   asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AuditLogs" ? "active" : "")">                                    
                                   <i class="nav-icon fas fa-clock-rotate-left"></i>
                                    <p>Audit Logs</p>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Reservations"
                                   asp-action="Index"
                                   class="nav-link">

                                    <i class="fas fa-clock"></i>

                                    <p>Reservations</p>

                                </a>
                            </li>
                        }

                    </ul>

                </nav>

            </div>

        </aside>

        <!-- Content -->

        <div class="content-wrapper">

            <section class="content pt-3">

                <div class="container-fluid">

                    @RenderBody()

                </div>

            </section>

        </div>

        <!-- Footer -->

        <footer class="main-footer">

            <strong>

                © 2026 Library Management System

            </strong>

            <div class="float-end">

                ASP.NET Core MVC

            </div>

        </footer>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/lib/admin-lte/js/adminlte.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (TempData["Success"] != null)
    {
        <script>

            Swal.fire({

                toast: true,

                position: 'top-end',

                icon: 'success',

                title: '@TempData["Success"]',

                showConfirmButton: false,

                timer: 2500

            });

        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>