@model LibraryManagement.ViewModels.UserDetailViewModel

@{
    ViewData["Title"] = "User Details";
}

<div class="card shadow border-0">

    <div class="card-body">

        <div class="text-center">

            <div class="profile-avatar">

                @Model.User.FullName.Substring(0, 1)

            </div>

            <h3 class="mt-3">

                @Model.User.FullName

            </h3>

            <span class="badge bg-primary">

                @Model.Role

            </span>

        </div>

        <hr />

        <table class="table table-borderless">

            <tr>

                <th width="180">

                    Email

                </th>

                <td>

                    @Model.User.Email

                </td>

            </tr>

            <tr>

                <th>

                    Username

                </th>

                <td>

                    @Model.User.UserName

                </td>

            </tr>

            <tr>

                <th>

                    Email Status

                </th>

                <td>

                    @if (Model.User.EmailConfirmed)
                    {
                        <span class="badge bg-success">

                            Confirmed

                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">

                            Not Confirmed

                        </span>
                    }

                </td>

            </tr>

            <tr>

                <th>

                    Account

                </th>

                <td>

                    @if (Model.IsLocked)
                    {
                        <span class="badge bg-danger">

                            Locked

                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">

                            Active

                        </span>
                    }

                </td>

            </tr>

            <tr>

                <th>

                    Created

                </th>

                <td>

                    @Model.User.CreatedDate.ToString("dd/MM/yyyy HH:mm")

                </td>

            </tr>

        </table>

        <hr />

        <a asp-action="ResetPassword"
           asp-route-id="@Model.User.Id"
           class="btn btn-warning">

            <i class="fas fa-key"></i>

            Reset Password

        </a>

        @if (Model.IsLocked)
        {
            <a asp-action="Unlock"
               asp-route-id="@Model.User.Id"
               class="btn btn-success">

                Unlock

            </a>
        }
        else
        {
            <a asp-action="Lock"
               asp-route-id="@Model.User.Id"
               class="btn btn-danger">

                Lock

            </a>
        }

        <a asp-action="Index"
           class="btn btn-secondary">

            Back

        </a>

    </div>

</div>