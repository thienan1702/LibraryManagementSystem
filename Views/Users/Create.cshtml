@model LibraryManagement.ViewModels.CreateUserViewModel

@{
    ViewData["Title"] = "Create User";
}

<div class="page-card mb-4">

    <div class="d-flex justify-content-between align-items-center">

        <div>

            <div class="page-title">

                <i class="fas fa-user-plus text-primary me-2"></i>

                Create User

            </div>

            <div class="page-subtitle">

                Create a new library system user and assign a role

            </div>

        </div>


        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="fas fa-arrow-left me-1"></i>

            Back to Users

        </a>

    </div>

</div>


<div class="page-card">

    <div asp-validation-summary="All"
         class="alert alert-danger"
         role="alert">
    </div>


    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()


        <div class="row">


            <!-- FULL NAME -->

            <div class="col-md-6 mb-4">

                <label asp-for="FullName"
                       class="form-label fw-semibold">

                    <i class="fas fa-user text-primary me-1"></i>

                    Full Name

                </label>

                <input asp-for="FullName"
                       class="form-control"
                       placeholder="Enter full name..." />

                <span asp-validation-for="FullName"
                      class="text-danger">
                </span>

            </div>


            <!-- EMAIL -->

            <div class="col-md-6 mb-4">

                <label asp-for="Email"
                       class="form-label fw-semibold">

                    <i class="fas fa-envelope text-primary me-1"></i>

                    Email

                </label>

                <input asp-for="Email"
                       type="email"
                       class="form-control"
                       placeholder="Enter email address..." />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>

            </div>


            <!-- ROLE -->

            <div class="col-md-6 mb-4">

                <label asp-for="Role"
                       class="form-label fw-semibold">

                    <i class="fas fa-user-shield text-primary me-1"></i>

                    Role

                </label>

                <select asp-for="Role"
                        class="form-select"
                        asp-items="new SelectList(ViewBag.Roles)">

                    <option value="">
                        -- Select Role --
                    </option>

                </select>

                <span asp-validation-for="Role"
                      class="text-danger">
                </span>

            </div>

        </div>


        <!-- ACTIONS -->

        <div class="d-flex justify-content-end gap-2 mt-3 pt-3 border-top">

            <a asp-action="Index"
               class="btn btn-secondary">

                <i class="fas fa-xmark me-1"></i>

                Cancel

            </a>


            <button type="submit"
                    class="btn btn-primary">

                <i class="fas fa-user-plus me-1"></i>

                Create User

            </button>

        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}