@using X.PagedList
@using X.PagedList.Mvc.Core

@model IPagedList<LibraryManagement.Models.Publisher>

@{
    ViewData["Title"] = "Publisher Management";
}

<div class="page-card mb-4">

    <div class="d-flex justify-content-between align-items-center">

        <div>

            <div class="page-title">

                <i class="fas fa-building text-primary"></i>

                Publisher Management

            </div>

            <div class="page-subtitle">

                Manage all publishers in the library

            </div>

        </div>

        <a asp-action="Create"
           class="btn btn-app btn-add">

            <i class="fas fa-plus"></i>

            Add Publisher

        </a>

    </div>

</div>


<!-- Search -->

<form asp-action="Index"
      method="get"
      class="mb-4">

    <div class="input-group">

        <span class="input-group-text">

            <i class="fas fa-search"></i>

        </span>

        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control"
               placeholder="Search publisher name or address..." />

        <button type="submit"
                class="btn btn-primary">

            <i class="fas fa-search"></i>

            Search

        </button>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="fas fa-rotate-left"></i>

            Reset

        </a>

    </div>

</form>


<!-- Statistics -->

<div class="row mb-4">

    <div class="col-md-3">

        <div class="small-box bg-primary">

            <div class="inner">

                <h3>@Model.TotalItemCount</h3>

                <p>Total Publishers</p>

            </div>

            <div class="icon">

                <i class="fas fa-building"></i>

            </div>

        </div>

    </div>

</div>


<!-- Publisher Table -->

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        @if (!Model.Any())
        {
            <div class="text-center py-5">

                <i class="fas fa-building-circle-xmark
                              fa-3x text-muted mb-3">
                </i>

                <h5>No publishers found</h5>

                <p class="text-muted mb-3">

                    There are no publishers matching your search.

                </p>

                <a asp-action="Create"
                   class="btn btn-primary">

                    <i class="fas fa-plus"></i>

                    Add Publisher

                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-dark">

                        <tr>

                            <th width="80">
                                #
                            </th>

                            <th>
                                Publisher
                            </th>

                            <th>
                                Address
                            </th>

                            <th width="280">
                                Action
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @{
                            int stt =
                            (Model.PageNumber - 1)
                            * Model.PageSize + 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- STT -->

                                <td>

                                    <span class="badge bg-primary">

                                        @stt

                                    </span>

                                </td>


                                <!-- Publisher -->

                                <td>

                                    <div class="d-flex align-items-center">

                                        <div class="avatar-circle">

                                            @if (!string.IsNullOrWhiteSpace(item.Name))
                                            {
                                                @item.Name.Substring(0, 1).ToUpper()
                                            }
                                            else
                                            {
                                                <i class="fas fa-building"></i>
                                            }

                                        </div>

                                        <div class="ms-2">

                                            <strong>
                                                @item.Name
                                            </strong>

                                        </div>

                                    </div>

                                </td>


                                <!-- Address -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.Address))
                                    {
                                        <span>

                                            <i class="fas fa-location-dot
                                                                  text-muted me-1">
                                            </i>

                                            @item.Address

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">

                                            No address

                                        </span>
                                    }

                                </td>


                                <!-- Actions -->

                                <td>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-app btn-edit">

                                        <i class="fas fa-edit"></i>

                                        Edit

                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-app btn-detail">

                                        <i class="fas fa-circle-info"></i>

                                        Details

                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          class="d-inline delete-form">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-app btn-delete">

                                            <i class="fas fa-trash"></i>

                                            Delete

                                        </button>

                                    </form>

                                </td>

                            </tr>

                            stt++;
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>


<!-- Pagination -->
@if (Model.PageCount > 1)
{
    <div class="d-flex justify-content-center mt-4">

        @Html.PagedListPager(
        Model,
        page => Url.Action(
        "Index",
        new
        {
            page,
            search = ViewBag.Search
        }),
        new PagedListRenderOptions
        {
            DisplayLinkToFirstPage =
        PagedListDisplayMode.Always,

            DisplayLinkToLastPage =
        PagedListDisplayMode.Always,

            DisplayLinkToPreviousPage =
        PagedListDisplayMode.Always,

            DisplayLinkToNextPage =
        PagedListDisplayMode.Always,

            LinkToFirstPageFormat = "<<",

            LinkToPreviousPageFormat = "Previous",

            LinkToNextPageFormat = "Next",

            LinkToLastPageFormat = ">>",

            MaximumPageNumbersToDisplay = 5,

            UlElementClasses =
        new[] { "pagination" },

            LiElementClasses =
        new[] { "page-item" },

            PageClasses =
        new[] { "page-link" }
        })

</div>
}


@section Scripts {

    <script>

        document
            .querySelectorAll(".delete-form")
            .forEach(form => {

                form.addEventListener("submit", function (e) {

                    e.preventDefault();

                    Swal.fire({

                        title: "Delete Publisher?",

                        text: "This action cannot be undone.",

                        icon: "warning",

                        showCancelButton: true,

                        confirmButtonColor: "#dc3545",

                        cancelButtonColor: "#6c757d",

                        confirmButtonText: "Delete",

                        cancelButtonText: "Cancel",

                        reverseButtons: true

                    }).then(result => {

                        if (result.isConfirmed) {

                            form.submit();

                        }

                    });

                });

            });

    </script>

}